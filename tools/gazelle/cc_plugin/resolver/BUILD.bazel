load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "resolver",
    srcs = ["resolver.go"],
    importpath = "github.com/stackav-oss/clockwork/tools/gazelle/cc_plugin/resolver",
    visibility = ["//visibility:public"],
    deps = [
        "//tools/gazelle/cc_plugin/common",
        "@@gazelle~//config",
        "@@gazelle~//label",
        "@@gazelle~//repo",
        "@@gazelle~//resolve",
        "@@gazelle~//rule",
        "@org_skia_go_infra//go/util",
