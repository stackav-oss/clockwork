use clockwork::tests::support::exec_time::{ExecTime, ExecState};
use clockwork::tests::support::shared_state_cogs::{NoSleepCog, LongSleepCog, SharedStateTesterCog};

// Channel for no sleep cog
channel NoSleepChannel
{
  message_type: Tachyon<ExecTime>;
  max_num_messages: 100;
}

// Channel for long sleep cog
channel LongSleepChannel
{
  message_type: Tachyon<ExecTime>;
  max_num_messages: 100;
}

box TestSharedStateBox
{
  new cog_state: State(representation=Tachyon<ExecState>);
  new tester_state_no_sleep: State(representation=Tachyon<ExecState>);
  new tester_state_long_sleep: State(representation=Tachyon<ExecState>);

  new no_sleep: NoSleepCog;
  new long_sleep: LongSleepCog;
  new tester: SharedStateTesterCog;

  connect no_sleep.exec_time to NoSleepChannel;
  connect long_sleep.exec_time to LongSleepChannel;

  connect cog_state to no_sleep.state;
  connect cog_state to long_sleep.state;

  connect tester_state_no_sleep to tester.state_no_sleep;
  connect tester_state_long_sleep to tester.state_long_sleep;
  connect NoSleepChannel to tester.input_no_sleep;
  connect LongSleepChannel to tester.input_long_sleep;
}

cpp_executable test_shared_state_system_exe
{
  casing
  {
    box TestSharedStateBox;
  }
}

cpu_domain SharedStateCpu;

box TestSharedStateSystem
{
  new box: TestSharedStateBox;
  new proc: Process(executable=test_shared_state_system_exe);
  apply HostProcess(process=proc) in box;
  apply HostCpuDomain(cpu_domain=SharedStateCpu) to proc;
}

system_target test_shared_state_system
{
  box: TestSharedStateSystem;
}
