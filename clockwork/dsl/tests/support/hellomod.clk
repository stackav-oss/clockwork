use clockwork::dsl::tests::support::{hellocog, hellomsg};
use clockwork::io::var_packet;
use clockwork::diagnostics::report;

// Common diagnostics bus
channel DiagnosticsChannel
{
  name: "/diagnostics";
  message_type: Tachyon<report::Report>;
  max_num_messages: 200;
  publishers: diagnostics;
}

// Channel for HelloMsg messages
channel HelloChan
{
    message_type: Tachyon<hellomsg::HelloMsg>;
    max_num_messages: 10;
}

// Another channel for HelloMsg messages
channel AnotherChan
{
    name: "Name that doesn't follow reasonable conventions!";
    message_type: Tachyon<hellomsg::HelloMsg>;
    max_num_messages: 101;
    publishers: single;
}

// A multi-publisher channel for HelloMsg messages
channel MultiPublisherChannel
{
    name: "many_publishers";
    message_type: Tachyon<hellomsg::HelloMsg>;
    max_num_messages: 11;
    publishers: multiple;
}

// UDP socket.
udp_socket IncomingUdpSocket
{
  address: 127.0.0.1;
  port: 12345;
  direction: incoming;
  message_type: Tachyon<var_packet::VarPacket<4>>;
}

// UDP socket.
udp_socket OutgoingUdpSocket
{
  address: 127.0.0.1;
  port: 12345;
  direction: outgoing;
  message_type: Tachyon<var_packet::VarPacket<4>>;
}

// Channel for incoming udp data.
channel NetworkData
{
  message_type: Tachyon<var_packet::VarPacket<4>>;
  max_num_messages: 10;
}

box MemBox
{
    new mem_hello: HeapMemory(max_size=1'000'000);
}

box HelloBox
{
    new mem_box: MemBox;

    new hello_cog: hellocog::HelloCogWithMetrics;
    connect mem_box.mem_hello to hello_cog.mem_hello;

    new hello_config: SerializedDataFile(representation=Protobuf<hellomsg::HelloMsg>, path="foo/bar.txtpb");
    connect hello_config to hello_cog.cfg_hello;

    // Define rw_hello_init first so that we test topological sort in genpd correctly.
    new rw_hello_init: hellocog::HelloInit2;
    new ro_hello_init: hellocog::HelloInit;

    new ro_hello: State(representation=Tachyon<hellomsg::HelloMsg>, init=ro_hello_init.result);
    connect ro_hello to hello_cog.ro_hello;

    new rw_hello: State(representation=Tachyon<hellomsg::HelloMsg>, init=rw_hello_init.result);
    // This connection creates a dependency that forces a specific init cog ordering.
    connect ro_hello to rw_hello_init.input;
    connect rw_hello to hello_cog.rw_hello;

    new extern_hello: State(representation=hellocog::CxxState, memory_resource=mem_box.mem_hello);
    connect extern_hello to hello_cog.extern_hello;

    connect HelloChan to hello_cog.latest_hello;
    connect HelloChan to hello_cog.history_of_hellos;
    connect MultiPublisherChannel to hello_cog.multi_publisher_hello;
    connect hello_cog.out_world to HelloChan;
    connect hello_cog.out_goodbye to AnotherChan;
    connect hello_cog.out_multi1 to MultiPublisherChannel;
    connect hello_cog.out_multi2 to MultiPublisherChannel;
    connect hello_cog.diagnostics to DiagnosticsChannel;

    new incoming_udp: IncomingUdpSocket;
    new outgoing_udp: OutgoingUdpSocket;

    connect incoming_udp to NetworkData;
    connect NetworkData to outgoing_udp;
}

cpu_domain HostA
{
  simplelaunch_node: "a";
  simplelaunch_src: "//clockwork/dsl/tests/support:host_a_simplelaunch_config.textproto";
  simplelaunch_src: "//clockwork/dsl/tests/support:host_b_simplelaunch_config.textproto";
  bridge_cpus: 0;
  default_cpus: 1 - 3;
}
cpu_domain HostB;

ethernet Lan1
{
    ipv4_address 1.2.3.4: HostA
    {
        bridge_ports: 16000 - 18000;
    }
    ipv4_address 1.2.3.5: HostB
    {
        bridge_ports: 16000 - 18000;
    }
}

box HelloProcs
{
    new hello_world1: HelloBox;
    new hello_world2: HelloBox;

    new hello_proc1: Process(executable=helloworld_exe);
    new hello_proc2: Process(executable=helloworld_exe);

    apply HostProcess(process=hello_proc1) in hello_world1;
    apply HostProcess(process=hello_proc2) in hello_world2;
}

box HelloSystem
{
    new host_a: HelloProcs;
    apply HostCpuDomain(cpu_domain=HostA) in host_a;

    new host_b: HelloProcs;
    apply HostCpuDomain(cpu_domain=HostB) in host_b;
}

box HelloBoxSys
{
    new box: HelloBox;
    new proc: Process(executable=helloworld_exe);
    apply HostProcess(process=proc) in box;
    apply HostCpuDomain(cpu_domain=HostA) to proc;
}

cpp_target hellomod
{
    options
    {
        namespace clockwork::testing;
    }

    udp_socket IncomingUdpSocket;
    udp_socket OutgoingUdpSocket;
}

cpp_executable helloworld_exe
{
    casing
    {
        interface Tap<Tachyon<hellomsg::HelloMsg>>;
        extern hellocog::CxxState;
        cog hellocog::HelloCogWithMetrics;
        udp_socket IncomingUdpSocket;
        udp_socket OutgoingUdpSocket;
        box HelloBox;
    }
}

system_target helloworld
{
    box: HelloBoxSys;
}
