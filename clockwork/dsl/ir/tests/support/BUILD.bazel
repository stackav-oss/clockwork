clk(
    name = "report_group_defs_clk",
    srcs = ["report_group_defs.clk"],
    outs = [
        "report_group_defs_clk_cc.cc",
        "report_group_defs_clk_cc.hh",
        "report_group_defs_clk_cc.inl",
        "report_group_defs_clk_cc_cog.cc",
        "report_group_defs_clk_cc_cog.hh",
        "report_group_defs_clk_cc_cog.inl",
        "report_group_defs_clk_cc_dial.cc",
        "report_group_defs_clk_cc_dial.hh",
        "report_group_defs_clk_cc_dial.inl",
        "report_group_defs_clk_cc_types.cc",
        "report_group_defs_clk_cc_types.hh",
        "report_group_defs_clk_cc_types.inl",
    ],
    cpp_deps = ["//std:signals_clk_cc"],
