diff --git python/private/stage1_bootstrap_template.sh python/private/stage1_bootstrap_template.sh
index c72e274..5964450 100644
--- python/private/stage1_bootstrap_template.sh
+++ python/private/stage1_bootstrap_template.sh
@@ -273,6 +273,14 @@ if [[ -z "${PYTHONSAFEPATH+x}" ]]; then
   interpreter_env+=("PYTHONSAFEPATH=${PYTHONSAFEPATH-1}")
 fi
 
+# Don't use packages from the user's personal site-packages directory
+# (~/.local/lib/pythonX.Y/site-packages). This ensures Bazel py_binary
+# targets are hermetic and don't accidentally pick up packages installed
+# outside of Bazel (e.g. via `pip install --user` or system pip).
+if [[ -z "${PYTHONNOUSERSITE+x}" ]]; then
+  interpreter_env+=("PYTHONNOUSERSITE=${PYTHONNOUSERSITE-1}")
+fi
+
 if [[ "$IS_ZIPFILE" == "1" ]]; then
   interpreter_args+=("-XRULES_PYTHON_ZIP_DIR=$zip_dir")
 fi
