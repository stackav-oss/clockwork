    ("liburing", "https://github.com/axboe/liburing.git", "6b5f5bc9a2e43ad3ee330a093d53d7a81816f676", PATCH),  # liburing-2.4
    ("lz4", SINGLE_VERSION_OVERRIDE, "1.10.0.bcr.1", NO_PATCH),
