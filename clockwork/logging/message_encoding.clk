#![generate(cpp)]
#![cpp(namespace=clockwork_logging)]

// Message encoding
enum MessageEncoding
{
  options
  {
    underlying_type: UInt16;
    enable_linter_override: "performance-enum-size";
  }

  values
  {
    // No encoding defined, opaque bytes
    #0 unspecified default { underlying_value: 0; }

    // No encoding defined, opaque bytes
    #1 undefined { underlying_value: 1; }

    // CDR
    #2 cdr { underlying_value: 2; }

    // Clockwork tachyon
    #3 tachyon { underlying_value: 3; }
  }
}
