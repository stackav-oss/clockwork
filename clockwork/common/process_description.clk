#![generate(cpp, py)]
#![cpp(namespace=clockwork::common)]

use[] clockwork::common::constants;
use clockwork::pinion::channel_config::{ChannelType};

MAX_INSTANCE_PATH_SIZE: UInt64 = 512;
MAX_COG_INSTANCES: UInt64 = 551;
// When updating this, search for all other MAX_ENDPOINTS_PER_COG and change those too
MAX_ENDPOINTS_PER_COG: UInt64 = 113;
MAX_STATE_INSTANCES: UInt64 = 391;
MAX_STATE_CONNECTIONS: UInt64 = 831;
MAX_CONFIG_INSTANCES: UInt64 = 357;
MAX_CONFIG_CONNECTIONS: UInt64 = 401;
MAX_FILE_PATH_SIZE: UInt64 = 4096;
MAX_INIT_COGS: UInt64 = 262;
MAX_PUBLISHERS: UInt64 = 2048;
MAX_PUBSUB_CONNECTIONS: UInt64 = 1871;
MAX_MEMORY_RESOURCES: UInt64 = 724;
MAX_MEMORY_RESOURCE_CONNECTIONS: UInt64 = 725;
MAX_TIMERS: UInt64 = 64;
MAX_IO_CONNECTIONS: UInt64 = 32;
MAX_NOT_CONNECTED_ENDPOINTS: UInt64 = 1024;
MAX_SNAPSHOT_CONFIGS: UInt64 = 512;
MAX_DATA_SOURCES: UInt64 = 512;

// Id for a cog type
tag CogClassId;
// Id for a cog instance, i.e. a particular graph node
tag CogInstanceId;
// Id for a connection point (publisher, config, etc) of a cog class
tag EndpointClassId;
// Id of a connection point of a cog instance, i.e. half of a graph edge
tag EndpointInstanceId;
// Id of a state
tag StateInstanceId;
// Id of a config
tag ConfigInstanceId;
// Id of a particular casing implementation (unused)
tag CasingClassId;
// Id of a process
tag ProcessInstanceId;
// Id of a memory resource
tag MemoryResourceId;
// Id of an io connection class
tag IoConnectionClassId;
// Id of an io connection class instance
tag IoConnectionInstanceId;

// Configuration for snapshotting a state or config endpoint
schema SnapshotConfig
{
  options
  {
    constructor: source_code_order;
  }

  fields
  {
    // The state or config endpoint to snapshot
    #1 endpoint_id: Uuid<EndpointInstanceId>;

    // Publisher ID for the snapshot channel
    #2 snapshot_publisher_id: Uuid<EndpointInstanceId>;

    // Time interval between snapshots in nanoseconds (optional)
    // For state snapshots (TakeSnapshots), at least one of interval_ns or cycles must be set
    // For config snapshots (SnapshotOnce), this will be nullopt
    #3 interval: Optional<Duration>;

    // Number of execution cycles between snapshots (optional)
    // For state snapshots (TakeSnapshots), at least one of interval_ns or cycles must be set
    // For config snapshots (SnapshotOnce), this will be nullopt
    #4 cycles: Optional<UInt32>;
  }
}

// Type of memory resource
enum MemoryResourceType
{
  values
  {
    // Use normal new+delete allocation
    #1 new_delete default;
  }
}

// Whether the not connected endpoint is a publisher or subscriber.
enum NotConnectedEndpointType
{
  values
  {
    // Publisher
    #1 publisher default;

    // Subscriber
    #2 subscriber;
  }
}

// Describes the clockwork graph for a particular process
schema ProcessDescription
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;

    // Max number of cog instances
    #2 max_cog_instances: UInt64 = MAX_COG_INSTANCES;

    // Max endpoints (pub + sub + config + etc) for a cog
    #3 max_endpoints_per_cog: UInt64 = MAX_ENDPOINTS_PER_COG;

    // Maximum number of states in the process
    #4 max_state_instances: UInt64 = MAX_STATE_INSTANCES;

    // Maximum number of state-cog connections in the process
    #5 max_state_connections: UInt64 = MAX_STATE_CONNECTIONS;

    // Maximum number of configs in the process
    #6 max_config_instances: UInt64 = MAX_CONFIG_INSTANCES;

    // Maximum number of config-cog connections in the process
    #7 max_config_connections: UInt64 = MAX_CONFIG_CONNECTIONS;

    // Maximum size of a path to a file
    #8 max_file_path_size: UInt64 = MAX_FILE_PATH_SIZE;

    // Maximum number of initialization cogs in the process
    #9 max_init_cogs: UInt64 = MAX_INIT_COGS;

    // Maximum number of publishers referenced by this process (includes both
    // local publishers and remote publishers that are subscribed to)
    #10 max_publishers: UInt64 = MAX_PUBLISHERS;

    // Maximum number of channel connections
    #11 max_pubsub_connections: UInt64 = MAX_PUBSUB_CONNECTIONS;

    // Maximum number of memory pools
    #12 max_memory_resources: UInt64 = MAX_MEMORY_RESOURCES;

    // Maximum number of memory pool to cog instance connections
    #22 max_memory_resource_connections: UInt64 = MAX_MEMORY_RESOURCE_CONNECTIONS;

    // Maximum number of timers
    #13 max_timers: UInt64 = MAX_TIMERS;

    // Maximum number of IO connections.
    #23 max_io_connections: UInt64 = MAX_IO_CONNECTIONS;

    // Maximum channel name length
    #27 max_channel_name_len: UInt64 = constants::MAX_CHANNEL_NAME_SIZE;

    // Maximum number of not connected endpoints
    #28 max_not_connected_endpoints: UInt64 = MAX_NOT_CONNECTED_ENDPOINTS;

    // Maximum number of snapshot configurations (state and config snapshots)
    #30 max_snapshot_configs: UInt64 = MAX_SNAPSHOT_CONFIGS;

    // Maximum number of data sources
    // Should be at least as large as max_config_instances and < max_data_source_id
    #32 max_data_sources: UInt64 = MAX_DATA_SOURCES;
  }

  fields
  {
    // ID of this process
    #14 process_id: Uuid<ProcessInstanceId>;

    // Every Cog instance, including init Cogs
    #15 cog_instances: VarArray<CogInstanceDescription<>, max_size=max_cog_instances>;

    // State instances and connections
    #16 state_graph: StateGraph<>;

    // Config instances and connections
    #17 config_graph: ConfigGraph<>;

    // Publishers and connections
    #18 pubsub_graph: PubSubGraph<>;

    // Memory resources
    #19 memory_resource_graph: MemoryResourceGraph<>;

    // Timer instances
    #20 timers: VarArray<TimerInstanceDescription<>, max_size=max_timers>;

    // Topologically sorted by config/state dependencies; execute in order
    #21 init_cogs: VarArray<Uuid<CogInstanceId>, max_size=max_init_cogs>;

    // IO Connections
    #24 io_connections: VarArray<IoConnectionInstanceDescription<>, max_size=max_io_connections>;

    // Log reader cog
    #26 log_cog: Uuid<CogInstanceId>;

    // Not Connected Endpoints
    #29 not_connected_endpoints: VarArray<NotConnectedEndpoint, max_size=max_not_connected_endpoints>;

    // Snapshot configurations for state and config endpoints
    #31 snapshot_configs: VarArray<SnapshotConfig, max_size=max_snapshot_configs>;

    // Data sources
    // NB: Data sources are identified by their index in this array.
    // Must be less than default_construct_data_source_sentinel
    #33 data_sources: VarArray<DataSource<>, max_size=max_data_sources>;
  }
}

// Description of publishers, subscribers, and the connections between them.
schema PubSubGraph
{
  parameters
  {
    // Maximum number of publishers referenced by this process
    #1 max_publishers: UInt64 = MAX_PUBLISHERS;
    // Maximum number of channel connections
    #2 max_pubsub_connections: UInt64 = MAX_PUBSUB_CONNECTIONS;
    // Maximum channel name length
    #5 max_channel_name_len: UInt64 = constants::MAX_CHANNEL_NAME_SIZE;
  }

  fields
  {
    // Sorted by publisher_id
    #3 publish_endpoints: VarArray<PublishEndpoint<>, max_size=max_publishers>;
    // Sorted by subscriber_id
    #4 connections: VarArray<PubSubConnection, max_size=max_pubsub_connections>;
  }
}

// Describes an instance of a Cog
schema CogInstanceDescription
{
  parameters
  {
    // Max endpoints (pub + sub + config + etc) for a cog
    #1 max_endpoints_per_cog: UInt64 = MAX_ENDPOINTS_PER_COG;
    // Max length of human readable id
    #2 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
  }

  fields
  {
    // ID of Cog class.  This matches something compiled-in to the casing.
    // Outside the casing, it's just an opaque ID.
    #3 cog_class_id: Uuid<CogClassId>;

    // ID of Cog instance.  This is not compiled-in but provided via the API.
    #4 cog_instance_id: Uuid<CogInstanceId>;

    // Array of endpoint instances
    #5 endpoints: VarArray<EndpointInstanceDescription, max_size=max_endpoints_per_cog>;

    // Human-readable name for this Cog instance
    #6 instance_path_name: VarString<max_size=max_instance_path_size>;
  }
}

// Represents an endpoint on a Cog instance
//
// Each Cog class has a certain set (number and type) of endpoints; these are
// the endpoint classes.  When a Cog is instantiated, each of the endpoint
// classes defined for the Cog class also get instantiated, each with its own
// instance ID.
schema EndpointInstanceDescription
{
  fields
  {
    // ID of the endpoint class.  This is compiled-in to the Cog class, behind the Casing API.
    #1 endpoint_class_id: Uuid<EndpointClassId>;

    // ID of the endpoint instance.  This is provided through the API.
    #2 endpoint_instance_id: Uuid<EndpointInstanceId>;
  }
}

// Additional information about a publish endpoint.
//
// We need information about both local and remote publishers.  For local
// publishers we create the buffer; for remote ones we need to connect to it
// and validate that it has the expected layout.
schema PublishEndpoint
{
  options
  {
    constructor: source_code_order;
  }

  parameters
  {
    // Maximum channel name length
    #5 max_channel_name_len: UInt64 = constants::MAX_CHANNEL_NAME_SIZE;
  }

  fields
  {
    // Compare this field to the current process_id to know if this is local
    // or remote.
    #1 process_id: Uuid<ProcessInstanceId>;

    // The name of the shared memory and UDS are determined by this ID.
    #2 publisher_id: Uuid<EndpointInstanceId>;

    // Layout of the Pinion buffer; create if publisher, validate if subscriber.
    #3 buffer_layout: PinionBufferLayout;

    // The number of subscribers; only relevant to the publisher.
    #4 num_subscribers: UInt16;

    // Channel name
    #6 channel_name: VarString<max_size=max_channel_name_len>;

    // Does the channel contain bulk data?
    #7 is_bulk_data: Bool;

    // The type of the channel
    #8 channel_type: ChannelType;
  }
}

// Non connected publishers and subscribers. These are endpoints that are not connected to any other endpoints
schema NotConnectedEndpoint
{
  options
  {
    constructor: source_code_order;
  }

  fields
  {
    // ID of the endpoint
    #1 endpoint_id: Uuid<EndpointInstanceId>;

    // Type of the endpoint
    #2 endpoint_type: NotConnectedEndpointType;

    // Layout of the Pinion buffer; create if publisher, validate if subscriber.
    #3 buffer_layout: PinionBufferLayout;
  }
}

// Describes layout of a Pinion buffer.
schema PinionBufferLayout
{
  options
  {
    constructor: source_code_order;
  }

  fields
  {
    // Number of slots (messages) in the buffer
    #1 num_slots: UInt64;
    // Size of each slot
    #2 message_size: UInt64;
    // True if the buffer is only published once
    #3 is_published_once: Bool;
    // Maximum number of messages that may be committed in a single execution cycle
    #4 max_msgs_per_exec: UInt64 = 1;
  }
}

// Describes a link between a publisher/subscriber pair.
// The ends of this link might be local or remote; we need info about remote endpoints also.
schema PubSubConnection
{
  fields
  {
    // Compare to current process_id to know if this is local or remote.  Only connect if local.
    #1 subscriber_process_id: Uuid<ProcessInstanceId>;
    // ID of subscriber; if local this matches something in a CogInstanceDescription
    #2 subscriber_id: Uuid<EndpointInstanceId>;
    // ID of publisher; if local this matches something in a CogInstanceDescription
    #3 publisher_id: Uuid<EndpointInstanceId>;
    // Used for certain channel types with type-dependent meaning, but generally names a global resource
    #4 subscriber_key: VarString<64>;
    // Used for certain channel types with type-dependent meaning, but generally names a global resource
    #5 publisher_key: VarString<64>;
  }
}

// Describes state instances and how they connect to Cog instances.
schema StateGraph
{
  parameters
  {
    // Maximum number of states in the process
    #1 max_state_instances: UInt64 = MAX_STATE_INSTANCES;

    // Max length of human readable id
    #2 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;

    // Maximum number of state-cog connections in the process
    #3 max_state_connections: UInt64 = MAX_STATE_CONNECTIONS;
  }

  fields
  {
    // All of the state instances
    #4 state_instances: VarArray<StateInstanceDescription<>, max_size=max_state_instances>;

    // Connections from state to Cogs
    #5 connections: VarArray<StateConnection, max_size=max_state_connections>;
  }
}

// Describes a specific instance of persistent state.
schema StateInstanceDescription
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
  }

  fields
  {
    // The representation class for the state.  Inside the casing, this is 1:1
    // with a concrete type compiled into the casing, but outside it's just an
    // opaque identifier for the type.
    #2 representation_id: Uuid<RepresentationTag>;

    // Unique ID for this specific instance.  Not compiled into the casing; this
    // must be provided to the casing via the API.
    #3 state_instance_id: Uuid<StateInstanceId>;

    // Human-readable name for this state instance.
    #4 instance_path_name: VarString<max_size=max_instance_path_size>;

    // Tachyon representation used for serializing external state snapshots.
    #5 snapshot_representation_id: Optional<Uuid<RepresentationTag>>;

    // Only serializable states are backed by a Pinion buffer.  This flag
    // indicates if a buffer is needed and if so the layout for the that
    // buffer.
    #6 maybe_buffer_layout: Optional<PinionBufferLayout>;

    // If this is non-Tachyon state (hybrid or pure C++) then it needs a memory
    // resource and this contains information about the associated memory buffer
    // used for allocating the state and its internal members.
    #8 maybe_memory_resource: Optional<Uuid<MemoryResourceId>>;

    // Data source to use for initialization of this state.
    // This can be default_construct_data_source_sentinel to indicate default construction.
    #9 init_data_source: UInt16 = default_construct_data_source_sentinel;
  }
}

// A connection between a state instance and a state endpoint on a Cog.
schema StateConnection
{
  fields
  {
    // State instance ID
    #1 state_id: Uuid<StateInstanceId>;
    // Cog endpoint instance ID
    #2 endpoint_id: Uuid<EndpointInstanceId>;
  }
}

// Describes Config instances and their connections to Cog instances
schema ConfigGraph
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
    // Maximum number of configs in the process
    #2 max_config_instances: UInt64 = MAX_CONFIG_INSTANCES;
    // Maximum number of config-cog connections in the process
    #3 max_config_connections: UInt64 = MAX_CONFIG_CONNECTIONS;
    // Maximum size of a path to a file
    #4 max_file_path_size: UInt64 = MAX_FILE_PATH_SIZE;
  }

  fields
  {
    // Instances of config schemas
    #5 config_instances: VarArray<ConfigInstanceDescription<>, max_size=max_config_instances>;
    // Connections from Config instances to Cog instances
    #6 connections: VarArray<ConfigConnection, max_size=max_config_connections>;
  }
}

// Type of data source
enum DataSourceType
{
  values
  {
    // File data source
    #1 file default;

    // First message on a channel from a log
    #2 log_first_message;
  }
}

// Maximum valid data source ID; anything above this value is a psuedo data source
max_data_source_id: UInt16 = 65533;
// Pseudo data source indicating the data should be default-constructed
default_construct_data_source_sentinel: UInt16 = 65534;
// Pseudo data source indicating there is no fallback data source (i.e. failure to load is an error)
no_fallback_data_source_sentinel: UInt16 = 65535;

// Describes a data source
schema DataSource
{
  options
  {
    constructor: source_code_order;
  }

  parameters
  {
    // Maximum size of a path to a file
    #1 max_file_path_size: UInt64 = MAX_FILE_PATH_SIZE;
  }

  fields
  {
    // Representation class ID.  This matches something compiled into the Casing.
    #2 representation_id: Uuid<RepresentationTag>;

    // Data source type
    #3 data_source_type: DataSourceType;

    // Path or channel name; interpretation depends on data_source_type
    #4 source_path_or_name: VarString<max_size=max_file_path_size>;

    // Fallback data source ID if this one is not available
    //
    // Data sources are identified by their index in the array of data sources.
    // If this is set to default_construct_data_source_sentinel then use default construction as the fallback.
    // If this is set to no_fallback_data_source_sentinel then there is no fallback and failure to load this
    // data source should be treated as an error.
    #5 fallback_source: UInt16;
  }
}

// Describes a Config instance
schema ConfigInstanceDescription
{
  options
  {
    constructor: source_code_order;
  }

  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
  }

  fields
  {
    // Instance ID for this instance.  This is not compiled-in but created
    // dynamically via the API.
    #2 config_instance_id: Uuid<ConfigInstanceId>;

    // Human-readable name for this config instance
    #3 instance_path_name: VarString<max_size=max_instance_path_size>;

    // Data source to use for initialization of this config.
    // This can be default_construct_data_source_sentinel to indicate default construction.
    #4 init_data_source: UInt16;
  }
}

// Connection between a Config instance and an endpoint on a Cog instance
schema ConfigConnection
{
  fields
  {
    // Config instance ID
    #1 config_id: Uuid<ConfigInstanceId>;

    // Endpoint instance ID.  This will match something in a
    // CogInstanceDescription
    #2 endpoint_id: Uuid<EndpointInstanceId>;
  }
}

// Represents a distinct memory resource to instantiate
schema MemoryResource
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
  }

  fields
  {
    // Unique ID; this is used elsewhere to refer to this instance.
    #2 memory_resource_id: Uuid<MemoryResourceId>;

    // Instance name; only used for diagnostic display
    #3 instance_path_name: VarString<max_size=max_instance_path_size>;

    // Type of resource to create; for now heap is the only type
    #4 resource_type: MemoryResourceType;

    // Max size of the resource (ignored for MVP)
    #5 resource_max_size: UInt64;
  }
}

// Connection between a MemoryResource instance and an endpoint on a Cog instance
schema MemoryResourceConnection
{
  fields
  {
    // MemoryResource instance ID
    #1 memory_resource_id: Uuid<MemoryResourceId>;

    // Endpoint instance ID.  This will match something in a CogInstanceDescription
    #2 endpoint_id: Uuid<EndpointInstanceId>;
  }
}

// Describes MemoryResource instances and their connections to Cog instances
schema MemoryResourceGraph
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
    // Maximum number of configs in the process
    #2 max_memory_resources: UInt64 = MAX_MEMORY_RESOURCES;
    // Maximum number of config-cog connections in the process
    #3 max_memory_resource_connections: UInt64 = MAX_MEMORY_RESOURCE_CONNECTIONS;
  }

  fields
  {
    // Instances of memory resources
    #4 memory_resources: VarArray<MemoryResource<>, max_size=max_memory_resources>;
    // Connections from memory resource instances to Cog instance endpoints
    #5 connections: VarArray<MemoryResourceConnection, max_size=max_memory_resource_connections>;
  }
}

// An instance of a Cog timer
schema TimerInstanceDescription
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
  }

  fields
  {
    // Unique ID for timer instance.  This will correspond to something inside a CogInstanceDescription
    #2 timer_id: Uuid<EndpointInstanceId>;

    // Human-readable instance name
    #3 instance_path_name: VarString<max_size=max_instance_path_size>;
  }
}

// An instance of an IO Connection description.
schema IoConnectionInstanceDescription
{
  parameters
  {
    // Max length of human readable id
    #1 max_instance_path_size: UInt64 = MAX_INSTANCE_PATH_SIZE;
  }

  fields
  {
    // Class ID
    #2 class_id: Uuid<IoConnectionClassId>;

    // Instance ID
    #6 instance_id: Uuid<IoConnectionInstanceId>;

    // Unique ID
    #3 endpoints: VarArray<EndpointInstanceDescription, 2>;

    // Human-readable instance name
    #4 instance_path_name: VarString<max_size=max_instance_path_size>;

    // Diags ID
    #5 diags_endpoint_id: Optional<Uuid<EndpointInstanceId>>;
  }
}

instantiate PublishEndpoint<>;
instantiate PubSubGraph<>;
instantiate StateInstanceDescription<>;
instantiate ConfigInstanceDescription<>;
instantiate MemoryResource<>;
instantiate MemoryResourceGraph<>;
instantiate TimerInstanceDescription<>;
instantiate IoConnectionInstanceDescription<>;
instantiate CogInstanceDescription<>;
instantiate StateGraph<>;
instantiate ConfigGraph<>;
instantiate DataSource<>;
instantiate ProcessDescription<>;
