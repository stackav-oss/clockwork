        // Latency from first execution attempt to actual execution (in units of 10ns)
        #3 attempt_to_exec_latency: MinMaxMean<TenNanoseconds>;

        // Number of re-queues before execution (count)
        #4 requeue_count: MinMaxMean<UInt16>;

        // Total execution count
        #5 execution_count: UInt16;

