#![generate(cpp, nanobind)]
#![cpp(namespace=clockwork::pinion)]

use[] clockwork::common::constants;

// TCP bridge client/server counters
schema BridgeClientServerCounters
{
  uuid: 2a57c3d4-9ef5-4479-a130-c2f8c3d5a75a;

  fields
  {
    // Channel name
    #16 channel_name: VarString<max_size=constants::MAX_CHANNEL_NAME_SIZE>;

    // Messages rate in hz
    #2 message_rate_hz: Float32;

    // Data rate in bytes per second
    #3 data_rate_bps: Float32;

    // Compressed data rate in bytes per second
    #4 compressed_data_rate_bps: Float32;

    // Compression ratio
    #5 compression_ratio: Float32;

    // Average latency between message publish time and when the bridge received the message
    #7 average_receive_latency: Duration;

    // Max latency between message publish time and when the bridge received the message
    #9 max_receive_latency: Duration;

    // Average time spent sending or receiving a message over a socket
    #10 average_transfer_time: Duration;

    // Max time spent sending or receiving a message over a socket
    #11 max_transfer_time: Duration;

    // Average time spent compressing or decopressing a message
    #12 average_compression_time: Duration;

    // Max time spent compressing or decopressing a message
    #13 max_compression_time: Duration;

    // Average latency between message publish time and when the bridge was done sending the message
    #14 average_bridge_latency: Duration;

    // Max latency between message publish time and when the bridge was done sending the message
    #15 max_bridge_latency: Duration;

    // Rate of null headers sent to avoid lost tails
    #17 null_header_rate_hz: Float32;

    // Rate of null headers sent for keep-alives
    #18 keep_alive_rate_hz: Float32;
  }
  history
  {
    version: 18;
    legacy_became: [1 -> 16];
  }
}

// TCP Bridge status diagnostics counters
schema BridgeStatusDiagnosticsCounters
{
  uuid: acc8de33-1231-4e6b-9c08-d1c12d461bd0;

  fields
  {
    // Dropped message count
    #1 drop_count: UInt64;

    // Failed send count
    #2 failed_sends: UInt64;

    // Closed socket count
    #3 closed_socket_count: UInt64;

    // Failed receive count
    #4 failed_recvs: UInt64;

    // Failed reservation count
    #5 failed_reservations: UInt64;

    // Malformed message count
    #6 malformed_messages: UInt64;

    // Failed commit count
    #7 failed_commits: UInt64;

    // Failed discard count
    #8 failed_discards: UInt64;

    // Client socket error count
    #9 client_socket_errors: UInt64;

    // Unrecoverable progress error count
    #10 progress_errors: UInt64;

    // EPoll error count
    #11 epoll_errors: UInt64;

    // Bridge status publish errors
    #12 status_errors: UInt64;

    // Max bridge latency
    #13 max_bridge_latency: Duration;

    // Max latency channel name
    #14 max_latency_channel_name: VarString<constants::MAX_CHANNEL_NAME_SIZE>;

    // Max bridge bulk data latency
    #15 max_bridge_bulk_data_latency: Duration;

    // Max bulk data latency channel name
    #16 max_bulk_data_latency_channel_name: VarString<constants::MAX_CHANNEL_NAME_SIZE>;
  }
  history
  {
    version: 17;
  }
}

// TCP Bridge status message
schema BridgeStatus
{
  uuid: 4d72acda-9d76-471c-a067-25a2b6325b4a;

  fields
  {
    // Bridge host name
    #1 host_name: VarString<max_size=31>;

    // Bridge client counters
    #2 client_counters: VarArray<BridgeClientServerCounters, max_size=257>;

    // Bridge server counters
    #3 server_counters: VarArray<BridgeClientServerCounters, max_size=257>;

    // Bridge diagnostics counters
    #4 diagnostics_counters: BridgeStatusDiagnosticsCounters;
  }
  history
  {
    version: 4;
  }
}
