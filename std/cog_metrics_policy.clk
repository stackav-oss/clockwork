#![generate(cpp)]
#![cpp(namespace=clockwork::cog_metrics)]

// Configuration for cog event metrics report group behavior
schema CogEventMetricsPolicyConfig
{
  fields
  {
    // Whether event metrics are enabled for this cog
    #0 enabled: Bool = true;

    // Maximum number of events per batch
    #1 batch_size: Optional<UInt64> = nullopt;

    // Minimum duration of the batching window
    #2 min_duration: Optional<Duration> = nullopt;

    // Maximum duration of the batching window
    #3 max_duration: Optional<Duration> = nullopt;

    // Whether to emit input view sequence numbers as metadata on unseen_messages signals
    #4 emit_sequence_numbers: Bool = true;
  }
}

// Policy for controlling cog event metrics report group generation
def policy CogEventMetricsPolicy
{
  binds_to: Cog;
  schema: CogEventMetricsPolicyConfig;
}

// Configuration for cog telemetry metrics report group behavior
schema CogTelemetryMetricsPolicyConfig
{
  fields
  {
    // Whether telemetry metrics are enabled for this cog
    #0 enabled: Bool = true;

    // Minimum duration of the aggregation window
    #1 min_duration: Optional<Duration> = nullopt;

    // Maximum duration of the aggregation window
    #2 max_duration: Optional<Duration> = nullopt;

    // Minimum number of observations before reporting
    #3 min_observations: Optional<UInt64> = nullopt;

    // Maximum number of observations before reporting
    #4 max_observations: Optional<UInt64> = nullopt;
  }
}

// Policy for controlling cog telemetry metrics report group generation
def policy CogTelemetryMetricsPolicy
{
  binds_to: Cog;
  schema: CogTelemetryMetricsPolicyConfig;
}
