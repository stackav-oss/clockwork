+                    any([s in file.short_path for s in ctx.attr.shared_object_exclude_substrings])
+                )
+                if include and not exclude:
+                    lib_path = file.short_path.removesuffix(file.basename).rstrip("/")
+                    ld_library_path[lib_path] = True
+
+        if ld_library_path:
+            paths = []
+            paths += expanded_env["LD_LIBRARY_PATH"].split(":") if "LD_LIBRARY_PATH" in expanded_env else []
+            paths += ld_library_path.keys()
+            expanded_env["LD_LIBRARY_PATH"] = ":".join(paths)
+
     providers.append(RunEnvironmentInfo(
