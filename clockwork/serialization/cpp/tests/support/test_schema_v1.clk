// SoA element schema version 1
schema SoaElementSchemaV1
{
  uuid: 8f2a4b91-3c5d-4e8f-9a1b-7d6e5c4f3a2b;
  options
  {
    soa_enabled: true;
    constructor: source_code_order;
  }
  fields
  {
    // ID field (unchanged in version 2)
    #1 id: Int32;
    // X coordinate (Int32 in version 1, Int64 in version 2)
    #2 x: Int32;
    // Y coordinate (Float32 in version 1, Float64 in version 2)
    #3 y: Float32;
    // Z coordinate (removed in version 2)
    #4 z: Float32;
    // Nested schema member that will upgrade from V1 to V2
    #6 nested: UpgradedMemberSchemaTypeV1;
    // VarArray of schema types (elements will upgrade from V1 to V2)
    #7 items: VarArray<UpgradedMemberSchemaTypeV1, max_size=5>;
  }
  history
  {
    version: 1;
  }
}
