// Init cog
cog HelloInit
{
    states
    {
        result: Tappy<hellomsg::HelloMsg>
        {
            mutable: true;
        }
    }
    execution
    {
        execute when: init;
    }
}

// Init cog
cog HelloInit2
{
    states
    {
        result: Tappy<hellomsg::HelloMsg>
        {
            mutable: true;
        }

        input: Tappy<hellomsg::HelloMsg>;
    }
    execution
    {
        execute when: init;
    }
}

cpp_target hellocog
{
  options
  {
    namespace clockwork::testing::cogs;
    generate_cog_metrics false;
  }
  extern
  {
    header_file: "clockwork/dsl/tests/support/cxx_state.hh";
    namespace: clockwork::testing;
    type
    {
        name: CxxState;
    }
  }
  cog HelloCog;
  cog HelloCogWithMetrics;
  cog HelloInit;
  cog HelloInit2;
}
