+""",
+            default = [],
+        ),
+        "shared_object_exclude_substrings": attr.string_list(
+            doc = """
+A list of substrings. Shared objects whose paths contain any of these substrings
+will be excluded from LD_LIBRARY_PATH inference. Has an effect only if `infer_ld_library_path`
+is enabled.
+""",
+            default = [],
+        )
     },
 )
 
diff --git python/private/interpreter_tmpl.sh python/private/interpreter_tmpl.sh
index c4e87fb..ba559e8 100644
--- python/private/interpreter_tmpl.sh
+++ python/private/interpreter_tmpl.sh
@@ -16,6 +16,10 @@ set +e # allow us to check for errors more easily
 readonly TARGET_FILE="%target_file%"
 MAIN_BIN=$(rlocation "$TARGET_FILE")
 
+# Prevent Python packages installed in user site-packages outside of Bazel from being used;
+# e.g. this ensures the Pylance VS Code extension won't show IntelliSense for Python packages installed outside of Bazel
+export PYTHONNOUSERSITE=1
+
 if [[ -z "$MAIN_BIN" || ! -e "$MAIN_BIN" ]]; then
   echo "ERROR: interpreter executable not found: $MAIN_BIN (from $TARGET_FILE)"
   exit 1
