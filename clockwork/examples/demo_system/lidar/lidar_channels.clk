use clockwork::examples::demo_system::lidar::lidar_message;

// Raw lidar channel
channel RawLidarChannel
{
  name: "/lidar/raw";
message_type: Tachyon<lidar_message::RawLidarMessage<lidar_message::returns_per_message, lidar_message::points_per_return>>;
  max_num_messages: 100;
}

// Motion compensated lidar sweep
channel LidarSweepChannel
{
  name: "/lidar/sweep";
  message_type: Tachyon<lidar_message::LidarSweepMessage<lidar_message::points_per_sweep>>;
  max_num_messages: 12;
}
