use clockwork::python::python_state::PythonState;
use clockwork::python::tests::support::test_config;
use clockwork::python::tests::support::test_input_message;
use clockwork::python::tests::support::test_output_message;
use clockwork::python::tests::support::test_state;

// Python init cog to test python cog generation
cog PythonInitCog
{
  states
  {
    python_state: PythonState
    {
      mutable: true;
    }
    state: Tappy<test_state::TestState>
    {
      mutable: true;
    }
  }

  execution
  {
    execute when: init;
  }

  python
  {
    dial: "clockwork.python.tests.support.py_python_cog_dial.PythonInitCogDial";
    impl: "clockwork.python.tests.support.py_python_cog_impl.PythonInitCogImpl";
  }
}

// Python cog to test python cog generation
cog PythonCog
{
  configs
  {
    config: Tappy<test_config::TestConfig>;
  }

  states
  {
    python_state: PythonState
    {
      mutable: true;
    }
    state: Tappy<test_state::TestState>
    {
      mutable: true;
    }
  }

  inputs
  {
    input1: Tappy<test_input_message::TestInputMessage>;
    input2: Tappy<test_input_message::TestInputMessage>;
  }

  outputs
  {
    output1: Tappy<test_output_message::TestOutputMessage>;
    output2: Tappy<test_output_message::TestOutputMessage>;
  }

  execution
  {
    condition new_input1: new_message(input1, min=1, max=1);
    condition new_input2: new_message(input2, min=1, max=1);
    execute when: new_input1 or new_input2;
  }

  python
  {
    dial: "clockwork.python.tests.support.py_python_cog_dial.PythonCogDial";
    impl: "clockwork.python.tests.support.py_python_cog_impl.PythonCogImpl";
  }
}

cpp_target python_cog
{
  options
  {
    namespace clockwork::python::tests;
  }

  python_cog PythonInitCog;
  python_cog PythonCog;
}

py_target py_python_cog_dial
{
  python_cog_dial PythonInitCog
  {
    states.state: "clockwork.python.tests.support.test_state_clk_nb.TestState";
  }

  python_cog_dial PythonCog
  {
    configs.config: "clockwork.python.tests.support.py_test_config.TestConfig";
    states.state: "clockwork.python.tests.support.test_state_clk_nb.TestState";
    inputs.input1: "clockwork.python.tests.support.py_test_input_message.TestInputMessage";
    inputs.input2: "clockwork.python.tests.support.test_input_message_clk_nb.TestInputMessage";
    outputs.output1: "clockwork.python.tests.support.py_test_output_message.TestOutputMessage";
    outputs.output2: "clockwork.python.tests.support.test_output_message_clk_nb.TestOutputMessage";
  }
}
