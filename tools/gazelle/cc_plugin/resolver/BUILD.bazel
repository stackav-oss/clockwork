)

go_test(
    name = "resolver_test",
    srcs = ["resolver_test.go"],
    embed = [":resolver"],
    deps = [
        "//tools/gazelle/cc_plugin/common",
        "@@gazelle~//label",
        "@@gazelle~//rule",
        "@com_github_stretchr_testify//assert",
    ],
)
