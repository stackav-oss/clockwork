#![generate(cpp)]
#![cpp(namespace=clockwork::demo_system::imu)]

// Fake IMU message, real IMU messages have a lot more in them.
schema ImuMessage
{
  uuid: 78719389-3d9e-4c7f-be13-bff86fa3ba91;
  fields
  {
    // Timestamp for when this message was generated.
    #0 time_of_validity: SyncTime;

    // X axis acceleration in meters/sec/sec
    #1 x_acceleration_mss: Float64;

    // Y axis acceleration in meters/sec/sec
    #2 y_acceleration_mss: Float64;

    // Z axis acceleration in meters/sec/sec
    #3 z_acceleration_mss: Float64;
  }
}
