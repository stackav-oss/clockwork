#![generate()]

use clockwork::logging::log_playback::end_of_log::{EndOfLog};
use clockwork::logging::channel_policy::{LogReaderPolicy};

// End of log channel. Name must match the one used in LogMessageFetcher.hh
channel EndOfLogChannel
{
  name: "/clockwork_logging/end_of_log";
  message_type: Tachyon<EndOfLog>;
  max_num_messages: 5;
}
