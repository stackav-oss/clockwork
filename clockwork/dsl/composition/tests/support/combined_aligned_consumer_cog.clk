#![generate(cpp, cpp_cog, cpp_test_cog)]
#![cpp(namespace=clockwork::testing::combined_aligned_consumer)]

use clockwork::dsl::composition::tests::support::aligned_consumer_aligner::{SimpleAligner, ConsumerEchoMsg};
use clockwork::dsl::composition::tests::support::secondary_consumer_aligner;

// A cog that executes when either of two available alignment groups receives a new message
cog CombinedAlignedConsumerCog
{
  aligned_inputs
  {
    first: SimpleAligner;
    second: secondary_consumer_aligner::SecondaryAligner;
  }
  outputs
  {
    echo: Tappy<ConsumerEchoMsg>;
  }
  execution
  {
    condition new_first: new_message(first);
    condition new_second: new_message(second);
    condition any_first: any_message(first);
    condition any_second: any_message(second);
    execute when: any_first and any_second and (new_first or new_second);
  }
}
