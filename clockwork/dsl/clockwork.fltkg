    , (channel_option_num_slots | channel_option_published_once), channel_option_publishers? , channel_option_enforce_backwards_compatibility? , channel_option_bulk_data? , channel_option_channel_type? , "}" , ;
channel_parameters_block := "parameters", "{", (channel_parameter , ";" , )* , "}" , ;
