diff --git MODULE.bazel MODULE.bazel
new file mode 100644
index 00000000..ba521cc1
--- /dev/null
+++ MODULE.bazel
@@ -0,0 +1,12 @@
+module(name = "rules_proto_grpc")
+
+bazel_dep(name = "bazel_skylib", version = "1.3.0")
+bazel_dep(name = "rules_proto", version = "5.3.0-21.7")
+bazel_dep(name = "protobuf", version = "1.21.10", repo_name = "com_google_protobuf")
+bazel_dep(name = "rules_cc")
+
+buf_cli = use_extension("//:extensions.bzl", "buf_cli")
+use_repo(
+    buf_cli, 
+    "protoc_gen_buf_lint_darwin_arm64", "protoc_gen_buf_lint_darwin_x86_64", "protoc_gen_buf_lint_linux_x86_64",
+)
diff --git extensions.bzl extensions.bzl
new file mode 100644
index 00000000..07e90868
--- /dev/null
+++ extensions.bzl
@@ -0,0 +1,13 @@
+load(
+    "@rules_proto_grpc//:repositories.bzl", 
+    "protoc_gen_buf_lint_darwin_arm64", "protoc_gen_buf_lint_darwin_x86_64", "protoc_gen_buf_lint_linux_x86_64",
+)
+
+def _buf_cli_impl(ctx):
+    protoc_gen_buf_lint_darwin_arm64()
+    protoc_gen_buf_lint_darwin_x86_64()
+    protoc_gen_buf_lint_linux_x86_64()
+
+buf_cli = module_extension(
+    implementation = _buf_cli_impl,
+)
