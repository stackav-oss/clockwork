load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")
load("//tools/rules:package.bzl", "package")

package(
    default_visibility = ["//visibility:public"],
)

cc_library(
    name = "gil_lock_guard",
    srcs = ["gil_lock_guard.cc"],
    hdrs = ["gil_lock_guard.hh"],
    deps = ["@rules_python//python/cc:current_py_cc_headers"],
)

cc_library(
    name = "python_init",
    srcs = ["python_init.cc"],
    hdrs = ["python_init.hh"],
    deps = [
        "@rules_python//python/cc:current_py_cc_headers",
        "@wise_enum",
    ],
)

cc_library(
    name = "python_object",
    srcs = [
        "python_object.cc",
        "python_object.inl",
    ],
    hdrs = ["python_object.hh"],
    deps = [
        "//jewels/meta:concepts",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_library(
    name = "python_state",
    srcs = ["python_state.cc"],
    hdrs = ["python_state.hh"],
    deps = [
        ":gil_lock_guard",
        ":python_object",
        "//jewels/memory:memory_resource",
    ],
)

clk(
    name = "python_state_clk",
    srcs = ["python_state.clk"],
    outs = [
        "python_state_clk_cc.cc",
        "python_state_clk_cc.hh",
        "python_state_clk_cc.inl",
        "python_state_clk_cc_types.cc",
        "python_state_clk_cc_types.hh",
        "python_state_clk_cc_types.inl",
    ],
    cpp_deps = [":python_state"],
    generate = ["cpp"],
)
