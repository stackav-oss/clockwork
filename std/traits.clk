// DFL Trait Definitions
//
// This module defines the core traits used by DFL for operator type checking.
// Traits declare what operations types support and what the result types are.
// This enables DSL-level type checking while deferring actual implementation to C++.

#![generate()]

// a + b
trait Add<Rhs = Self>
{
  type Output;
}

// a - b
trait Sub<Rhs = Self>
{
  type Output;
}

// a * b
trait Mul<Rhs = Self>
{
  type Output;
}

// a / b
trait Div<Rhs = Self>
{
  type Output;
}

// a % b
trait Rem<Rhs = Self>
{
  type Output;
}

// -a
trait Neg
{
  type Output;
}

// +a
trait Pos
{
  type Output;
}

// |a|
trait Abs
{
  type Output;
}

// Logical not
trait Not
{
  type Output;
}

// Logical and
trait And<Rhs = Self>
{
  type Output;
}

// Logical or
trait Or<Rhs = Self>
{
  type Output;
}

// Ordering comparison
trait Ord<Rhs = Self>
{
  type Output;
}

// Equality comparison
trait Eq<Rhs = Self>
{
  type Output;
}
impl Add for Int8
{
  type Output = Int8;
}
