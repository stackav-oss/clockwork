# Stretch everything out to be the same length so we can use list comprehensions normally.
DEPENDENCIES_NUM_FIELDS = 4

dependencies = [d + ((None,) * (DEPENDENCIES_NUM_FIELDS - len(d))) for d in raw_dependencies]

patch_strip = {
    # keep-sorted start
    # The rules_python Gazelle plugin is a subdir of the rules_python repo.
    "rules_python_gazelle_plugin": 1,
    # keep-sorted end
}

patch_cmds = {
    # keep-sorted start block=yes
    "protobuf": ["""find . -name *.h -print0 | xargs -0 sed -i'' -e '1 i\\\n#pragma GCC system_header'"""],
    "wise_enum": [
        # The docs say that we can have 256 enum items but we can only actually have 128.
        # We need more than that in some places, so regenarate the header.
        """python3 create_generated.py 256 wise_enum_generated.h""",
    ],
    # keep-sorted end
}

[bazel_dep(name = name) for name, _, _, _ in dependencies]

[archive_override(
    module_name = name,
    integrity = integrity,
    patch_cmds = patch_cmds.get(name, []),
    patches = ["//third_party/patches:" + name + ".patch"] if should_patch else [],
    # GitHub tarballs have a top-level dir named after the repo and hash.
    strip_prefix = url[len("https://github.com/"):-len(".tar.gz")].split(
        "/",
        maxsplit = 1,
    )[1].replace("/archive/", "-"),
    urls = [url],
) for name, url, integrity, should_patch in dependencies if (url.startswith("https://github.com/") and "/archive/" in url)]

[archive_override(
    module_name = name,
    # How could anyone have guessed this: https://github.com/bazelbuild/bazel/issues/17803
    # To get checksum you need to pipe the file through `openssl dgst -sha256 -binary | openssl base64 -A` and prefix "sha256-"
    integrity = integrity,
    patch_cmds = patch_cmds.get(name, []),
    patches = ["//third_party/patches:" + name + ".patch"] if should_patch else [],
    urls = [url],
) for name, url, integrity, should_patch in dependencies if url.endswith((".tar.gz", ".tar.zst", ".tar.xz")) and not (url.startswith("https://github.com/") and "/archive/" in url)]

[local_path_override(
    module_name = lib,
    path = ("third_party/" + lib) if custom_path == None else custom_path,
) for lib, remote, custom_path, _ in dependencies if remote == LOCAL_PATH_OVERRIDE]

[single_version_override(
    module_name = name,
    patch_cmds = patch_cmds.get(name, []),
    patch_strip = patch_strip.get(name, 0),
    patches = ["//third_party/patches:" + name + ".patch"] if should_patch else [],
    version = version,
) for name, version, should_patch, _ in dependencies if not version.endswith((".git", ".tar.gz", ".tar.zst", ".tar.xz", LOCAL_PATH_OVERRIDE))]

register_toolchains(
    "@clang//:clang-aarch64-gnu-linux",
    "@clang//:clang-x86_64-gnu-linux",
    dev_dependency = True,
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(
    configure_coverage_tool = True,
    ignore_root_user_error = True,
    python_version = "3.10",
)
python.toolchain(
    configure_coverage_tool = True,
    ignore_root_user_error = True,
    python_version = "3.12",
)
use_repo(python, "python_3_10")
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.whl_mods(
    # Works around this issue https://github.com/bazelbuild/rules_python/issues/1000
    additive_build_content = """
filegroup(
    name = "bin_uv",
    srcs = ["bin/uv"],
)
""",
    data = [":bin_uv"],
    hub_name = "clockwork_whl_mods_hub",
    whl_name = "uv",
)
use_repo(pip, "clockwork_whl_mods_hub")

# Shared configuration for the dual-parsed `@clockwork_pip` hub (3.10 + 3.12).
CLOCKWORK_PIP_HUB_ALIASES = {"uv": ["bin_uv"]}

CLOCKWORK_PIP_WHL_MODIFICATIONS = {
    # keep-sorted start
    "@clockwork_whl_mods_hub//:uv.json": "uv",
    # keep-sorted end
}

# Target platforms for cross-platform wheel resolution under rules_python 2.0.
# Applied uniformly to every `pip.parse()` invocation below.
CLOCKWORK_PIP_TARGET_PLATFORMS = [
    "linux_x86_64",
    "linux_aarch64",
]

# The default conversion of native namespace packages into pkg-util namespace packages by automatically generating
# __init__.py files in every directory breaks pyrefly's import resolution for type-checking, so we set
# enable_implicit_namespace_pkgs = True on all pip.parse calls.
#
# After the 3.10->3.12 flip, `requirements_3_12.txt` is the primary lock.
# TODO(DX-29): Once py_3_10_* consumers are removed, drop the 3.10 compat entry below.
CLOCKWORK_PIP_HUBS = [
    {
        "extra_hub_aliases": CLOCKWORK_PIP_HUB_ALIASES,
        "hub_name": "clockwork_pip",
        "python_version": "3.12",
        "requirements_lock": "//tools/language_support:requirements_3_12.txt",
        "whl_modifications": CLOCKWORK_PIP_WHL_MODIFICATIONS,
    },
    # Compatibility parse for py_3_10_* transitions.
    # TODO(DX-29): retire once all py_3_10_* consumers are migrated away.
    {
        "extra_hub_aliases": CLOCKWORK_PIP_HUB_ALIASES,
        "hub_name": "clockwork_pip",
        "python_version": "3.10",
        "requirements_lock": "//tools/language_support:requirements_3_10.txt",
        "whl_modifications": CLOCKWORK_PIP_WHL_MODIFICATIONS,
    },
    {
        "hub_name": "clockwork_pip310",
        "python_version": "3.10",
        "requirements_lock": "//tools/language_support:requirements_pip310.txt",
    },
]

[pip.parse(
    enable_implicit_namespace_pkgs = True,
    extra_hub_aliases = hub.get("extra_hub_aliases", {}),
    hub_name = hub["hub_name"],
    python_version = hub["python_version"],
    requirements_lock = hub["requirements_lock"],
    target_platforms = CLOCKWORK_PIP_TARGET_PLATFORMS,
    whl_modifications = hub.get("whl_modifications", {}),
) for hub in CLOCKWORK_PIP_HUBS]

use_repo(pip, "clockwork_pip")
use_repo(pip, "clockwork_pip310")

## Protobuf
register_toolchains("@build_stack_rules_proto//toolchain:standard")

# golang
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.nogo(nogo = "//tools/golang:clockwork_nogo")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    # keep-sorted start
    "com_github_bazelbuild_buildtools",
    "com_github_emirpasic_gods",
    "com_github_stretchr_testify",
    "org_golang_google_genproto_googleapis_api",
    "org_golang_google_protobuf",
    "org_skia_go_infra",
    # keep-sorted end
)

go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.module_override(
    patches = ["third_party/patches/go_tree_sitter.patch"],
    path = "github.com/smacker/go-tree-sitter",
)

root_repo = use_extension("//tools/repo:root_repo.bzl", "root_repo")
use_repo(root_repo, "root_repo")
