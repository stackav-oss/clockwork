// Logger configuration
schema LoggerConfig {
  uuid: c6456c0b-cb9e-450b-9a74-e70bc01177d5;

  fields
  {

    // Log root directory
    #1 log_root_dir: VarString<256>;

    // Shared memory root directory
    #2 pinion_shm_root: VarString<256>;

    // Pinion unix socket namespace
    #3 pinion_namespace: VarString<64>;

    // Maximum writer rate in MiB/sec
    #4 max_write_mib_per_sec: UInt64;

    // Maximum log file duration in seconds
    #5 max_log_file_duration_sec: Int64;
  }
}

cpp_target logger_config
{
  options
  {
    namespace clockwork_logging;
  }

  schema LoggerConfig;
  representation Tachyon<LoggerConfig>;
  interface LoggerConfigTap: Tap<Tachyon<LoggerConfig>>;
}

proto_target logger_config_proto
{
  options
  {
    package clockwork.logging.writers.proto;
  }
  representation Protobuf<LoggerConfig>;
}

cpp_target logger_config_proto_conv
{
  options
  {
    namespace clockwork_logging;
  }
  converter ProtobufToTap<Protobuf<LoggerConfig>, Tap<Tachyon<LoggerConfig>>>;
}
