load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")
load("//tools/rules:python.bzl", "py_library")

package(default_visibility = ["//clockwork:__subpackages__"])

exports_files(
    [
        "common_cog_event_metrics.clk",
        "common_cog_telemetry_metrics.clk",
        "ten_nanosecond.clk",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "clk_cog_metrics",
    srcs = ["clk_cog_metrics.py"],
    deps = [
        "//clockwork/dsl/ir:module_id",
        "//clockwork/dsl/ir:node",
    ],
)

clk(
    name = "common_cog_event_metrics_clk",
    srcs = ["common_cog_event_metrics.clk"],
    outs = [
        "common_cog_event_metrics_clk_cc.cc",
        "common_cog_event_metrics_clk_cc.hh",
        "common_cog_event_metrics_clk_cc.inl",
    ],
    cpp_deps = [":ten_nanosecond_clk_cc"],
    generate = ["cpp"],
    minimize_builtin_deps = True,
    visibility = ["//visibility:public"],
    deps = [":ten_nanosecond_clk"],
)

clk(
    name = "common_cog_telemetry_metrics_clk",
    srcs = ["common_cog_telemetry_metrics.clk"],
