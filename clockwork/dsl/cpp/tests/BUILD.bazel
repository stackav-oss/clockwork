load("@aspect_rules_py//py:defs.bzl", "py_pytest_main")
load("//tools/rules:python.bzl", "py_test")

package(default_testonly = True)

py_pytest_main(
    name = "__test__",
    deps = ["@clockwork_pip//pytest"],
)

py_test(
    name = "context_test",
    srcs = [
        "context_test.py",
        ":__test__",
    ],
    main = ":__test__.py",
    deps = [
        ":__test__",
        "//clockwork/dsl/bazel:cc_targets",
        "//clockwork/dsl/bazel:targets",
        "//clockwork/dsl/cpp:context",
        "//clockwork/dsl/ir:module_id",
        "@clockwork_pip//pytest",
    ],
)

