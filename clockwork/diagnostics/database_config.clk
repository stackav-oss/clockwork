#![generate(cpp)]
#![cpp(namespace=clockwork::diagnostics)]

use clockwork::diagnostics::report;

max_reporter_name: UInt64 = 512;

max_reporters: UInt64 = 400;

// Display information for a reporter
schema ReporterInfo
{
  options
  {
    constructor: source_code_order;
  }
  fields
  {
    // Uuid for this reporter
    #2 id: Uuid<report::ReporterId>;

    // Name of this reporter (matches `SignalGroupId`)
    #3 name: VarString<max_reporter_name>;

    // Name of this instance, may be empty if it's the only one (matches `SignalGroup<>::InstanceType`)
    #4 instance: VarString<max_reporter_name>;
  }
  history
  {
    version: 5;
  }
}

//
schema DatabaseInfo
{
  options
  {
    constructor: source_code_order;
  }
  fields
  {
    // Connections to remote bridge servers.
    #3 reporters: VarArray<ReporterInfo, max_size=max_reporters>;
  }
}
