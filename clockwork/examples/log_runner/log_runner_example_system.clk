use clockwork::examples::log_runner::example_cogs::ExampleCogPublisher;
use clockwork::examples::log_runner::example_cogs::ExampleCogSubscriber;
use clockwork::examples::log_runner::test_message::TestMessage;
use clockwork::logging::channel_policy::{ChannelLoggingPolicy, LogType, LogReaderPolicy};
// A channel
channel Chan1
{
    message_type: Tachyon<TestMessage>;
    max_num_messages: 11;
}

// Another channel
channel Chan2
{
    message_type: Tachyon<TestMessage>;
    max_num_messages: 11;
}

// Our log reader policy
policy LogReaderPolicy for Chan1
{
    source_name = 'test_channel';
}

// Our log writer policy
policy ChannelLoggingPolicy for Chan2
{
    log_type = LogType::telemetry;
}

// Another channel
channel Chan3
{
    message_type: Tachyon<TestMessage>;
    max_num_messages: 11;
}

// Our log reader policy
policy LogReaderPolicy for Chan3
{
    source_name = 'test_channel2';
}

// Our log writer policy
policy ChannelLoggingPolicy for Chan3
{
    log_type = LogType::telemetry;
}

box LogRunnerExampleBox
{
    new example_cog_subscriber: ExampleCogSubscriber;
    new example_cog_publisher: ExampleCogPublisher;
    connect Chan1 to example_cog_subscriber.test_message_input;
    connect example_cog_publisher.test_message_output to Chan2;
}

cpu_domain SimCpu;

box LogRunnerExample
{
    new box: LogRunnerExampleBox;
    new proc: Process(executable=log_runner_example_exe);
    apply HostProcess(process=proc) in box;
    apply HostCpuDomain(cpu_domain=SimCpu) to proc;
}

cpp_executable log_runner_example_exe
{
    casing
    {
        box LogRunnerExampleBox;
    }
}

system_target log_runner_example_system
{
    box: LogRunnerExample;
}
