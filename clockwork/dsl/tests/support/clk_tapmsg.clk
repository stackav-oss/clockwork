}

// Enum
enum SomeEnum
{
  uuid: 02d1a601-5c69-46dd-9922-06fee33b581e;
  values
  {

    // First value
    #3 first_value default;

    // Second value
    #4 second_value;
  }
  history
  {
    version: 4;
    legacy_became: [1 -> 3];
    removed: [2];
  }
}

// Flags enum
enum SomeFlags
{
  uuid: 9d66eef8-1019-48a2-971e-f9bb8b2df06c;
  options
  {
    bit_flags;
    underlying_type: UInt8;
  }
  values
  {
    // No bits set
    #0 none default { underlying_value: 0; }
    // LSB
    #3 flag1 { underlying_value: 1; }
    // Bit1
    #4 flag2 { underlying_value: 2; }
    // Bit1
    #5 flag3 { underlying_value: 4; }
    // Bit0 + Bit1
    #6 flag12 { underlying_value: 3; }
  }
  history
  {
    version: 6;
    legacy_became: [1 -> 3];
    removed: [2];
  }
}

