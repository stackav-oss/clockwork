#![generate()]

use clockwork::examples::demo_system::imu::imu_message;

// Generic IMU channel (parameterized channel example)
channel ImuChannel
{
  parameters
  {
    name: String;
    type: Type;
  }

  name: fmt!("{name}");
  message_type: Tachyon<type>;
  max_num_messages: 10;
}

RawImuChannel = ImuChannel<name="/raw_imu", type=imu_message::ImuMessage>;
