diff --git python/private/attributes.bzl python/private/attributes.bzl
index e62abf9f..9e212c10 100644
--- python/private/attributes.bzl
+++ python/private/attributes.bzl
@@ -417,6 +417,30 @@ Specifies additional environment variables to set when the target is executed by
         # The value is required, but varies by rule and/or rule type. Use
         # create_stamp_attr to create one.
         "stamp": None,
+        "infer_ld_library_path": attr.bool(
+            default = False,
+            doc = """
+Whether to automatically set the `LD_LIBRARY_PATH` environment variable based on
+shared libraries (`.so` files) found in the target's runfiles. This is useful for
+C++ binaries that link against shared libraries, such as CUDA. If `True`,
+`LD_LIBRARY_PATH` will include the directories containing the relevant shared libraries.
+"""),
+        "shared_object_include_substrings": attr.string_list(
+            doc = """
+A list of substrings. Only shared objects whose paths contain any of these substrings
+will be considered for LD_LIBRARY_PATH inference. If empty, all .so files are included.
+Has an effect only if `infer_ld_library_path` is enabled.
+""",
+            default = [],
+        ),
+        "shared_object_exclude_substrings": attr.string_list(
+            doc = """
+A list of substrings. Shared objects whose paths contain any of these substrings
+will be excluded from LD_LIBRARY_PATH inference. Has an effect only if `infer_ld_library_path`
+is enabled.
+""",
+            default = [],
+        )
     },
     allow_none = True,
 )
