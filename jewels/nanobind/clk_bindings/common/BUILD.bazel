load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("//tools/rules:cc.bzl", "cc_library")
load("//tools/rules:python.bzl", "py_library")
load(":common_clk_nanobind_libraries.bzl", "COMMON_CC_DEPS", "COMMON_PY_DEPS")

# meta-library for common C++ deps for autogenerated CLK nanobind targets
# keep
cc_library(
    name = "common_cc",
    visibility = ["//visibility:public"],
    deps = COMMON_CC_DEPS,
)

# expose the single source of truth
py_library(
    name = "common_clk_nanobind_libraries",
    srcs = ["common_clk_nanobind_libraries.py"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "common_clk_nanobind_libraries_bzl",
    srcs = ["common_clk_nanobind_libraries.bzl"],
)

# copy the .bzl file to python so we can make a library and have a single source of truth for common libraries
copy_file(
    name = "common_clk_nanobind_libraries_py",
    src = "common_clk_nanobind_libraries.bzl",
    out = "common_clk_nanobind_libraries.py",
    allow_symlink = True,
    visibility = ["//clockwork/dsl/ir:__subpackages__"],
)

# meta-library for common python deps for autogenerated CLK nanobind targets
py_library(
    name = "common_py",
    visibility = ["//visibility:public"],
    deps = COMMON_PY_DEPS,
)
