#![generate(cpp, cpp_cog, cpp_exe)]
#![cpp(namespace=clockwork::tools)]

use clockwork::tools::channel_spy::channel_spy_config::{ChannelSpyConfig};

// Cog to copy the channel spy configuration to /dev/shm at startup
cog SpyConfigInitCog
{
  resources
  {
    memres: persistent;
  }

  configs
  {
    spy_config : Tappy<ChannelSpyConfig<>>;
  }

  execution
  {
      execute when: init;
  }
}

box SpyConfigInitBox
{
  new spy_init_cog:  SpyConfigInitCog;
}
