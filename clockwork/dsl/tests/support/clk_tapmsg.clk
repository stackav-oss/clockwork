// Message to test Tap.
schema TapMsg
{
  uuid: cae6ee0b-ec41-40cf-8b87-fb1583e5985d;
  parameters
  {
    // Int64 initial value
    #0 signed_value: Int32 = 234;
  }
  fields
  {
    // Integer type
    #1 integer: Int64;

    // Floating point type and primitive with default
    #2 floating_point: Float32 = 1.25;

    // Bool
    #3 boolean: Bool;

    // Array of primitives
    #4 array_of_primitives: VarArray<Int32, max_size=9>;

    // Array of array of primitives
    #5 array_of_array: VarArray<VarString<max_size=3>, max_size=2>;

    // UUID of schema tag in same namespace
    #6 uuid: Uuid<SubMsg>;

    // UUID of tag in different namespace
    #7 uuid_different_namespace: Uuid<AnotherTagAlias>;

    // Default enum.
    #8 default_enum: SomeEnum;

    // Enum with init.
    #9 enum_with_init: SomeEnum = SomeEnum::second_value;

    // Default enum.
    #20 default_flags: SomeFlags;

    // Enum with init.
    #21 flags_with_init: SomeFlags = SomeFlags::flag2;

    // Nested schemas.
    #10 nested_schema: SubMsg;

    // Array of schemas.
    #11 array_of_schema: VarArray<type=SubMsg, max_size=2>;

    // Duration type
    #12 duration: Duration;

    // Sync time
    #13 sync_time: SyncTime;

    // Optional
    #14 optional: Optional<type=UInt32>;

    // Bool init
    #15 bool_with_init: Bool = true;

    // Strong type
    #16 strong_type: MyStrongType;

    // External strong type
    #17 external_strong_type: UInt32 = 123;

    // Fixed array
    #18 fixed_array: FixedArray<type=Int32, size=2>;

    // VarString
    #23 var_string: VarString<max_size=2>;

    // Integer type with init
    #24 integer_with_init: Int32 = signed_value;
  }
  history
  {
    version: 24;
    legacy_became: [19 -> 23];
    removed: [22];
  }
}

