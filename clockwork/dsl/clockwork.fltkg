expr := instantiate | call | macro_call | subscript | type_union | namespaced_identifier | dotted_identifier | identifier | literal | list;

instantiate := operand:expr . "<" , arg_list? , ">";
call := operand:expr . "(" , arg_list? , ")";
macro_call := operand:expr . "!(" , arg_list? , ")";
subscript := operand:expr . "[" , (wildcard:"*" | index:expr) , "]";
arg_list := arg , ("," , arg)* , trailing_comma:","?;
