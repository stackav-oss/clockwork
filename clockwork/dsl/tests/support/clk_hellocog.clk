// Init cog
cog HelloInit
{
    states
    {
        result: Tappy<clk_hellomsg::HelloMsg>
        {
            mutable: true;
        }
    }
    execution
    {
        execute when: init;
    }
}

// Init cog
cog HelloInit2
{
    states
    {
        result: Tappy<clk_hellomsg::HelloMsg>
        {
            mutable: true;
        }

        input: Tappy<clk_hellomsg::HelloMsg>;
    }
    execution
    {
        execute when: init;
    }
