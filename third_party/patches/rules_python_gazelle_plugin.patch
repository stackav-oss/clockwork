 ) {
+	if r.Kind() == grpcPyLibraryKind {
+		// We just look at these libs to find their source filenames. We don't actually modify them.
+		return
+	}
+	if r.Kind() == protoPyLibraryKind {
+		// build_stack_rules_proto emits raw .proto imports, but the Python plugin
+		// is registered later, so Gazelle delegates this rule's deps to us.
+		imports, ok := modulesRaw.([]string)
+		if !ok {
+			return
+		}
+
+		cfgs := c.Exts[languageName].(pythonconfig.Configs)
+		cfg := cfgs[from.Pkg]
+
+		// Start with dependencies supplied by the proto generator.
+		deps := treeset.NewWith(godsutils.StringComparator)
+		for _, dep := range r.AttrStrings("deps") {
+			deps.Add(dep)
+		}
+		for _, imp := range imports {
+			// Generated Python modules replace the .proto suffix with _pb2.
+			pythonImport := strings.ReplaceAll(strings.TrimSuffix(imp, ".proto")+"_pb2", "/", ".")
+			// Wheel-provided generated modules are not indexed as first-party rules.
+			if dep, _, ok := cfg.FindThirdPartyDependency(pythonImport); ok {
+				deps.Add(dep)
+				continue
+			}
+
+			matches := ix.FindRulesByImportWithConfig(
+				c,
+				resolve.ImportSpec{Lang: languageName, Imp: pythonImport},
+				languageName,
+			)
+			if len(matches) != 1 || matches[0].IsSelfImport(from) {
+				continue
+			}
+			deps.Add(matches[0].Label.Rel(from.Repo, from.Pkg).String())
+		}
+		if !deps.Empty() {
+			r.SetAttr("deps", convertDependencySetToExpr(deps))
+		}
+		return
+	}
+
+	switch modulesRaw.(type) {
+	case nil:
+	case *treeset.Set:
+		break
+	default:
+		fmt.Fprintf(os.Stderr, "gazelle: Error: The name of Python target %s conflicts with the name of another target Gazelle is trying to modify.\n", from)
+		return
+	}
+
 	// TODO(f0rmiga): may need to be defensive here once this Gazelle extension
 	// join with the main Gazelle binary with other rules. It may conflict with
 	// other generators that generate py_* targets.
