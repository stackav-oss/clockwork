load("//clockwork:rules.bzl", "clk")
load("//jewels/simplelaunch:rules.bzl", "merge_simplelaunch_config")
load("//tools/rules:cc.bzl", "cc_binary", "cc_library")

package(
    default_testonly = True,
    default_visibility = ["//clockwork/examples/approx_aligner:__subpackages__"],
)

cc_library(
    name = "test_cogs",
    srcs = [
        "test_cogs.cc",
        "test_cogs.inl",
    ],
    hdrs = ["test_cogs.hh"],
    deps = [
        ":test_cogs_dial",
        ":test_cogs_impl",
        "//clockwork/cog:include_common",
    ],
)

clk(
    name = "test_cogs_clk",
    srcs = ["test_cogs.clk"],
    outs = [
        "test_cogs.cc",
        "test_cogs.hh",
        "test_cogs.inl",
        "test_cogs_dial.cc",
        "test_cogs_dial.hh",
        "test_cogs_dial.inl",
    ],
    deps = [
        "//clockwork/dial:approx_aligner_config_clk",
        "//clockwork/examples/approx_aligner:approx_aligner_msgs_clk",
    ],
)

cc_library(
    name = "test_cogs_dial",
    srcs = [
        "test_cogs_dial.cc",
        "test_cogs_dial.inl",
    ],
    hdrs = ["test_cogs_dial.hh"],
    deps = [
        "//clockwork/dial:include_common",
        "//clockwork/examples/approx_aligner:approx_aligner_msgs",
    ],
)

cc_library(
    name = "test_cogs_impl",
    srcs = ["test_cogs_impl.cc"],
    deps = [
        ":test_cogs_dial",
        "//clockwork/dial:msg_input",
        "//clockwork/examples/approx_aligner:approx_aligner_msgs",
        "//clockwork/pinion:publisher_handle",
        "//jewels/container:circular_buffer",
        "@boost//:iterator",
        "@catch2//:catch2_main",
    ],
)

clk(
    name = "test_system_clk",
    srcs = ["test_system.clk"],
    outs = [
        "clockwork.clockwork.examples.approx_aligner.tests.support.test_system.test_system.proc.tachyon",
        "test_system.test_system.TestCpu_channel_allocations.csv",
        "test_system.test_system.TestCpu_channel_spy_config.tachyon",
        "test_system.test_system.TestCpu_event_logger_config.tachyon",
        "test_system.test_system.TestCpu_simplelaunch_config.textproto",
        "test_system.test_system.TestCpu_telemetry_logger_config.tachyon",
        "test_system_exe.cc",
        "test_system_exe.hh",
        "test_system_exe.inl",
    ],
    deps = [
        ":test_cogs_clk",
        "//clockwork/dial:approx_aligner_config_clk",
        "//clockwork/examples/approx_aligner:approx_aligner_cog_clk",
        "//clockwork/examples/approx_aligner:approx_aligner_msgs_clk",
    ],
)

cc_binary(
    name = "test_system_exe",
    srcs = [
        "test_system_exe.cc",
        "test_system_exe.hh",
        "test_system_exe.inl",
    ],
    deps = [
        ":test_cogs",
        "//clockwork:repr_iface",
        "//clockwork:tags",
        "//clockwork/dial:approx_aligner_config",
        "//clockwork/dial:approx_aligner_config_proto_cc_library",
        "//clockwork/dial:approx_aligner_config_proto_conv",
        "//clockwork/examples/approx_aligner:approx_aligner_cog",
        "//clockwork/examples/approx_aligner:approx_aligner_msgs",
        "//clockwork/scaffolding:abstract_casing",
        "//clockwork/scaffolding:casing",
        "//clockwork/scaffolding:offline_main",
        "//jewels/memory:memory_resource",
        "//jewels/memory:pmr_shared_ptr",
        "//jewels/uuid",
    ],
)

cc_library(
    name = "test_system_lib",
    srcs = [
        "test_system_exe.cc",
        "test_system_exe.inl",
    ],
    hdrs = ["test_system_exe.hh"],
    deps = [
        ":test_cogs",
        "//clockwork:repr_iface",
        "//clockwork:tags",
        "//clockwork/dial:approx_aligner_config",
        "//clockwork/dial:approx_aligner_config_proto_cc_library",
        "//clockwork/dial:approx_aligner_config_proto_conv",
        "//clockwork/examples/approx_aligner:approx_aligner_cog",
        "//clockwork/examples/approx_aligner:approx_aligner_msgs",
        "//clockwork/scaffolding:abstract_casing",
        "//clockwork/scaffolding:casing",
        "//jewels/memory:memory_resource",
        "//jewels/memory:pmr_shared_ptr",
        "//jewels/uuid",
    ],
)

merge_simplelaunch_config(
    name = "testcpu.textproto",
    srcs = [
        "test_system.test_system.TestCpu_simplelaunch_config.textproto",
        "@clockwork//clockwork/launch:clockwork_prelaunch.textproto",
    ],
    data = [
        "clockwork.clockwork.examples.approx_aligner.tests.support.test_system.test_system.proc.tachyon",
        "test_system.test_system.TestCpu_channel_allocations.csv",
        "test_system.test_system.TestCpu_channel_spy_config.tachyon",
        "test_system.test_system.TestCpu_event_logger_config.tachyon",
        "test_system.test_system.TestCpu_telemetry_logger_config.tachyon",
        ":test_system_exe",
        "@clockwork//clockwork/pinion:tcp_bridge_main",
    ],
)
