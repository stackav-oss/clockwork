#![generate(cpp)]
#![cpp(namespace=clockwork::aligner_metrics)]
use std::cog_metrics_policy::{CogEventMetricsPolicyConfig, CogTelemetryMetricsPolicyConfig};

// Policy for controlling aligner event metrics report group generation
def policy AlignerEventMetricsPolicy
{
  binds_to: Aligner;
  schema: CogEventMetricsPolicyConfig;
}

// Policy for controlling aligner telemetry metrics report group generation
def policy AlignerTelemetryMetricsPolicy
{
  binds_to: Aligner;
  schema: CogTelemetryMetricsPolicyConfig;
}
