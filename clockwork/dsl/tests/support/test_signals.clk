#![generate()]

// Simple signal
signal simple_signal: UInt32;

// Signal with custom name
signal named_signal: Float64
{
  name: "custom_signal_name";
}

// Multi-instance signal
signal multi_signal: Int64
{
  multi_instance: true;
}

// Signal with metadata
signal metadata_signal: UInt64
{
  metadata: String;
}

// Signal with pre-aggregation
signal aggregated_signal: Float32
{
  pre_aggregation: ["min", "max", "mean"];
}

// Complex signal with multiple options
signal complex_signal: UInt32
{
  name: "complex_name";
  multi_instance: true;
  metadata: UInt64;
  pre_aggregation: ["sum", "count"];
}
