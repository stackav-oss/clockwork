#![generate(cpp, cpp_exe)]
#![cpp(namespace=clockwork::demo)]

use clockwork::io::var_packet;
use clockwork::io::udp_sample_system::ping_pong;
use clockwork::io::udp_sample_system::just_a_uint32;

// Incoming socket
udp_socket IncomingSocketVarPacket
{
  address: 127.0.0.1;
  port: 2370;
  direction: incoming;
  message_type: Tachyon<var_packet::VarPacket<4>>;
}

// Outgoing socket
udp_socket OutgoingSocketVarPacket
{
  address: 127.0.0.1;
  port: 2370;
  direction: outgoing;
  message_type: Tachyon<var_packet::VarPacket<4>>;
}

// Incoming socket
udp_socket IncomingSocketJustAUInt32
{
  address: 127.0.0.1;
  port: 2371;
  direction: incoming;
  message_type: Tachyon<just_a_uint32::JustAUInt32>;
}

// Outgoing socket
udp_socket OutgoingSocketJustAUInt32
{
  address: 127.0.0.1;
  port: 2371;
  direction: outgoing;
  message_type: Tachyon<just_a_uint32::JustAUInt32>;
}

// Channel from ping cog to outgoing socket.
channel PingChannelVarPacket
{
  message_type: Tachyon<var_packet::VarPacket<4>>;
  max_num_messages: 10;
}

// Channel from incoming udp to pong cog.
channel PongChannelVarPacket
{
  message_type: Tachyon<var_packet::VarPacket<4>>;
  max_num_messages: 10;
}

// Channel from ping cog to outgoing socket.
channel PingChannelJustAUInt32
{
  message_type: Tachyon<just_a_uint32::JustAUInt32>;
  max_num_messages: 10;
}

// Channel from incoming udp to pong cog.
channel PongChannelJustAUInt32
{
  message_type: Tachyon<just_a_uint32::JustAUInt32>;
  max_num_messages: 10;
}

box DemoUdpSystemProcBox
{

  new ping_cog: ping_pong::PingCog;
  new outgoing_socket_var_packet: OutgoingSocketVarPacket;
  new outgoing_socket_just_a_uint32: OutgoingSocketJustAUInt32;

  new incoming_socket_var_packet: IncomingSocketVarPacket;
  new incoming_socket_just_a_uint32: IncomingSocketJustAUInt32;
  new pong_cog: ping_pong::PongCog;

  connect ping_cog.ping_var_packet to PingChannelVarPacket;
  connect PingChannelVarPacket to outgoing_socket_var_packet;

  connect incoming_socket_var_packet to PongChannelVarPacket;
  connect PongChannelVarPacket to pong_cog.pong_var_packet;

  connect ping_cog.ping_just_a_uint32 to PingChannelJustAUInt32;
  connect PingChannelJustAUInt32 to outgoing_socket_just_a_uint32;

  connect incoming_socket_just_a_uint32 to PongChannelJustAUInt32;
  connect PongChannelJustAUInt32 to pong_cog.pong_just_a_uint32;
}

cpu_domain DemoCpu;

box DemoUdpSystem
{
  new box: DemoUdpSystemProcBox;
  new proc: Process(executable=demo_udp_boxes_clk_exe);
  apply HostProcess(process=proc) in box;
  apply HostCpuDomain(cpu_domain=DemoCpu) to proc;
}
