diff --git BUILD.bazel BUILD.bazel
new file mode 100644
index 0000000..2cebd9d
--- /dev/null
+++ BUILD.bazel
@@ -0,0 +1,72 @@
+load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
+load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
+
+copy_file(
+    name = "copy_compat_h",
+    src = select({
+        "@platforms//cpu:x86_64": "compat.x86_64.h",
+        "@platforms//cpu:aarch64": "compat.aarch64.h",
+    }),
+    out = "src/include/liburing/compat.h",
+)
+
+cc_library(
+    name = "liburing",
+    hdrs = ["src/include/liburing/compat.h"] + glob(["src/**/*.h"]),
+    srcs = glob(["src/**/*.c"], exclude = ["src/nolibc.c"]),
+    includes = ["src/include"],
+    visibility = ["//visibility:public"],
+    local_defines = select({
+        "@platforms//cpu:aarch64": ["__NR_open"],
+        "//conditions:default": [],
+    }),
+)
+
+cc_library(
+    name = "test_helpers",
+    hdrs = ["test/helpers.h"],
+    srcs = ["test/helpers.c"],
+    includes = ["test"],
+    visibility = ["//:__pkg__"],
+    deps = [":liburing"],
+)
+
+cc_test(
+    name = "fadvise_test",
+    srcs = ["test/fadvise.c"],
+    local_defines = ["_GNU_SOURCE"],
+    deps = [
+        ":liburing",
+        ":test_helpers",
+    ],
+)
+
+cc_test(
+    name = "fpos_test",
+    srcs = ["test/fpos.c"],
+    local_defines = ["_GNU_SOURCE"],
+    deps = [
+        ":liburing",
+        ":test_helpers",
+    ],
+)
+
+cc_test(
+    name = "short_read_test",
+    srcs = ["test/short-read.c"],
+    local_defines = ["_GNU_SOURCE"],
+    deps = [
+        ":liburing",
+        ":test_helpers",
+    ],
+)
+
+test_suite(
+    name = "tests",
+    tests = [
+        "@liburing//:fadvise_test",
+        "@liburing//:fpos_test",
+        "@liburing//:short_read_test",
+    ],
+    visibility = ["//visibility:public"],
+)
