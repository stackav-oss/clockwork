#![generate(cpp)]
#![cpp(namespace=clockwork::common)]
use clockwork::common::constants;
use clockwork::common::process_description;

// The type of logging requested (event vs telemetry)
enum LogType
{
  uuid: acca0266-322b-484b-80a8-d79f55feaf48;
  values
  {
    // Don't log
    #0 none default;

    // Log during events only
    #1 event;

    // Log non-redundantly in telemetry log (all the time) and also in events
    #2 non_redundant_telemetry;
  }

  history
  {
    version: 3;
  }
}

// Aggregation types for signals
// Matches the AggregationType enum in signal.py
enum AggregationType
{
  uuid: 8b1548ad-26f3-4ab8-8d4b-9987deb17832;

  values
  {
    // No aggregation - raw value
    #0 Value default;

    // Minimum value
    #1 Min;

    // Maximum value
    #2 Max;

    // Sum of values
    #3 Sum;

    // Count of values
    #4 Count;

    // Mean (average) of values
    #5 Mean;

    // Final (last) value
    #6 FinalValue;

    // First value
    #7 FirstValue;
  }
}

// Report group type (batched vs aggregated)
enum ReportGroupType
{
  uuid: e5e1c8e5-b642-4a84-8e2b-a6e66290ee8f;

  values
  {
    // Batched - signals collected in arrays
    #0 Batched default;

    // Aggregated - signals post-processed with aggregation functions
    #1 Aggregated;
  }
}

// Source used to determine whether a report-group signal is present
enum SignalValiditySource
{
  uuid: 9dc88515-e678-4c41-8079-cd85bb7ac4d9;

  values
  {
    // Metadata predates explicit signal presence tracking
    #0 legacy_assume_present default;

    // Presence is determined from a serialized count-derived field
    #1 count_field;

    // Presence is determined from a generated signal-presence bit
    #2 presence_bit;
  }
}

// Signal definition with pre-aggregation configuration
schema SignalMetadata
{
  uuid: 1c39188e-db5a-429f-8fdf-0718e05d202b;

  parameters
  {
    // Maximum signal name size
    #0 max_signal_name_size = 150;

    // Maximum aggregation definition string size
    #1 max_aggregation_definition_size = 80;

    // Maximum number of pre-aggregation types
    #2 max_pre_aggregation_types = 10;
  }

  fields
  {
    // Signal name (e.g., "OtherSignal", "BarSignal")
    #3 name: VarString<max_signal_name_size>;

    // Pre-aggregation type for the signal
    #4 pre_aggregation_type: VarArray<AggregationType, max_pre_aggregation_types>;

    // DSL string that defined the aggregation (e.g., "[min, max]" or "value")
    #5 pre_aggregation_definition: VarString<max_aggregation_definition_size>;

    // Indexes into SignalMetadataConfig.signal_instance_names
    // Lists all instances of this signal
    #6 signal_instance_indexes: VarArray<UInt32, 4002>;
  }

  history
  {
    version: 8;
  }
}

instantiate SignalMetadata<>;

// Signal entry within a report group
schema ReportGroupSignalMetadata
{
  uuid: 08b5bc24-8bec-49f4-a8d2-7f3a0526e95a;

  parameters
  {
    // Maximum alias size
    #0 max_alias_size = 100;

    // Maximum post-aggregation types
    #1 max_post_aggregation_types = 10;
  }

  fields
  {
    // Index into the Signals array
    #2 signal_index: UInt32;

    // Post-aggregation types applied to this signal
    // Empty for batched report groups
    #3 post_aggregation_types: VarArray<AggregationType, max_post_aggregation_types>;

    // Optional alias for the signal (used when multiple instances exist)
    #4 alias: Optional<VarString<max_alias_size>>;

    // Source used to determine whether this signal is present
    #5 validity_source: SignalValiditySource;

    // Clockwork field number for count_field, or bit index for presence_bit
    #6 validity_index: UInt32;
  }

  history
  {
    version: 5;
  }
}

instantiate ReportGroupSignalMetadata<>;

// Report group configuration
schema ReportGroupMetadata
{
  uuid: 9ffc333d-15f8-4f25-9705-12cbaca642a0;

  parameters
  {
    // Maximum report group name size
    #0 max_report_group_name_size = 100;

    // Maximum number of signals in a report group
    #1 max_num_signals = 250;
  }

  fields
  {
    // Report group name (e.g., "foosignals")
    #2 name: VarString<max_report_group_name_size>;

    // Log type (Event or Telemetry)
    #3 log_type: LogType;

    // Report group type (Batched or Aggregated)
    #4 report_group_type: ReportGroupType;

    // Aggregation size (number of executions to aggregate)
    #5 aggregation_size: UInt32;

    // Minimum duration between reports
    #6 min_duration: Duration;

    // Maximum duration between reports
    #7 max_duration: Duration;

    // Signals in this report group
    #8 signals: VarArray<ReportGroupSignalMetadata<>, max_num_signals>;
  }
}

instantiate ReportGroupMetadata<>;

// Cog class with all its report groups
