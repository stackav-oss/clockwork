load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

exports_files([
    "clk_parametrized_box.clk",
])

clk(
    name = "clk_parametrized_box_clk",
    srcs = ["clk_parametrized_box.clk"],
    outs = [
        "clk_parametrized_box_clk_cc.cc",
        "clk_parametrized_box_clk_cc.hh",
        "clk_parametrized_box_clk_cc.inl",
        "clk_parametrized_box_clk_cc_cog.cc",
        "clk_parametrized_box_clk_cc_cog.hh",
        "clk_parametrized_box_clk_cc_cog.inl",
        "clk_parametrized_box_clk_cc_dial.cc",
        "clk_parametrized_box_clk_cc_dial.hh",
        "clk_parametrized_box_clk_cc_dial.inl",
        "clk_parametrized_box_clk_cc_types.cc",
        "clk_parametrized_box_clk_cc_types.hh",
        "clk_parametrized_box_clk_cc_types.inl",
        "clk_parametrized_box_clk_exe.cc",
        "clk_parametrized_box_clk_exe.hh",
        "clk_parametrized_box_clk_exe.inl",
    ],
    cpp_exe_deps = ["//clockwork/scaffolding:online_main"],
    generate = [
        "cpp",
        "cpp_cog",
        "cpp_exe",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "clk_parametrized_box_clk_cc_impl",
    srcs = ["clk_parametrized_box_clk_cc_impl.inl"],
    hdrs = ["clk_parametrized_box_clk_cc_impl.hh"],
    deps = [":clk_parametrized_box_clk_cc_dial"],
