load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

clk(
    name = "test_message_clk",
    srcs = ["test_message.clk"],
    outs = [
        "test_message_clk_cc.cc",
        "test_message_clk_cc.hh",
        "test_message_clk_cc.inl",
        "test_message_clk_cc_types.cc",
        "test_message_clk_cc_types.hh",
        "test_message_clk_cc_types.inl",
    ],
    generate = ["cpp"],
)

cc_library(
    name = "test_message_handle",
    srcs = ["test_message_handle.inl"],
    hdrs = ["test_message_handle.hh"],
)

cc_library(
    name = "test_support",
    srcs = [
        "test_support.cc",
        "test_support.inl",
    ],
    hdrs = ["test_support.hh"],
    deps = [
        "//clockwork/logging:channel_type_clk_cc",
        "//clockwork/logging:log_error",
        "//clockwork/logging:log_timestamp",
        "//clockwork/logging:nolint_helper",
        "//clockwork/logging:schema_encoding_clk_cc",
        "//clockwork/logging:xxh3_checksum",
        "//clockwork/logging:zstd_helper",
        "//clockwork/logging/onboard:log_format",
        "//clockwork/logging/onboard:reader",
        "//clockwork/logging/onboard:types",
        "//jewels/container:at",
        "//jewels/filesystem",
        "//jewels/filesystem:error_code",
        "//jewels/filesystem:file_descriptor",
        "//jewels/log_cerr",
        "//jewels/memory:default_memory_resource",
        "//jewels/memory:memory_resource",
        "//jewels/std:expected",
        "@fmt",
    ],
)
