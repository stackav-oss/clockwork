use clockwork::dsl::tests::support::hellomsg;

// Goodbye, Cog!
//
// This is a maximally empty cog to test the empty cases.
cog GoodbyeCog
{
  execution
  {
    execute when: init;
  }
  metrics_options
  {
    enabled: false;
  }
}

cpp_target goodbyecog
{
  options
  {
    namespace clockwork::cogs;
  }

  cog GoodbyeCog;
}
