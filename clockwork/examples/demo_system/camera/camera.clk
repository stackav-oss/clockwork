#![generate(cpp, cpp_cog, cpp_exe)]
#![cpp(namespace=clockwork::demo_system::camera)]

use[] clockwork::examples::demo_system::cpu_domain;
use[] clockwork::examples::demo_system::camera::video_channels;
use clockwork::examples::demo_system::camera::video_message;

// Camera driver state to generate random numbers
#[cpp(type_namespace=clockwork::demo_system::camera, type_header="clockwork/examples/demo_system/camera/camera_state.hh")]
extern_type CameraState;

// Cog to simulate receiving YUV411 video frames from the camera
cog CameraDeviceCog
{
  states
  {
    state: CameraState
    {
      mutable: true;
    }
  }

  outputs
  {
    raw_camera: Tappy<video_message::Yuv411Image<video_message::raw_image_size_bytes>>;
  }

  execution
  {
    condition periodic_100ms: time_since_last_exec(100ms);
    execute when: periodic_100ms;
  }
}

// Cog to convert the raw YUV411 frames to YUV444 for processing
cog CameraDriverCog
{
  inputs
  {
    raw_camera: Tappy<video_message::Yuv411Image<video_message::raw_image_size_bytes>>;
  }

  outputs
  {
    camera: Tappy<video_message::Yuv444Image<video_message::image_size_bytes>>;
  }

  execution
  {
    condition new_raw_camera: new_message(raw_camera, max=1);
    execute when: new_raw_camera;
  }
}

box CameraBox
{
  new device_cog: CameraDeviceCog;
  new driver_cog: CameraDriverCog;

  new memory: HeapMemory(max_size=4'096);
  new state: State(representation=CameraState, memory_resource=memory);

  connect state to device_cog.state;
  connect device_cog.raw_camera to video_channels::RawVideoChannel;
  connect video_channels::RawVideoChannel to driver_cog.raw_camera;
  connect driver_cog.camera to video_channels::VideoChannel;
}

box CameraExe
{
  new camera_box: CameraBox;
  new camera_proc: Process(executable=camera_clk_exe);
  apply HostProcess(process=camera_proc) in camera_box;
  apply HostCpuDomain(cpu_domain=cpu_domain::LocalHost) to camera_proc;
}
