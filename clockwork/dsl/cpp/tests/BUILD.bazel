        "//clockwork/dsl/cpp:types",
        "//clockwork/dsl/ir:clkbuiltins",
        "//clockwork/dsl/ir:primitive",
        "//clockwork/dsl/ir:typesys",
        "@clockwork_pip//pytest",
    ],
)

