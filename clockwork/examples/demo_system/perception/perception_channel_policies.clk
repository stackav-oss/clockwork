#![generate()]

use clockwork::logging::channel_policy::{ChannelLoggingPolicy, LogType};
use clockwork::logging::channel_type::{ChannelType};
use clockwork::examples::demo_system::perception::perception_channels;

// Defining this policy adds the channel to both the telemetry log writer configuration and
// the event log writer configuration. Setting the log type to event would only add the
// channel to the event log writer configuration. This demo only uses the telemetry writer configuration.
policy ChannelLoggingPolicy for perception_channels::PerceptionDebugChannel
{
  log_type = LogType::telemetry;
}

// Defining this policy adds the channel to both the telemetry log writer configuration and
// the event log writer configuration. Setting the log type to event would only add the
// channel to the event log writer configuration. This demo only uses the telemetry writer configuration.
//
// Setting the channel type to persistent means that any slice of the log will contain the latest
// message published prior to the start of the slice.
policy ChannelLoggingPolicy for perception_channels::PerceptionAlignerConfigChannel
{
  log_type = LogType::telemetry;
  channel_type = ChannelType::persistent;
}
