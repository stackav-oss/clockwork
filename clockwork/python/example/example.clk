#![generate(py_exe)]

use clockwork::logging::log_writer_config;
use[cpp, proto, proto_conv] clockwork::logging::writers::channel_message_rates_config;
use clockwork::logging::writers::logger;
use[] clockwork::logging::writers::logger_channel_policies;
use[] clockwork::logging::writers::logger_channels;
use[cpp, proto, proto_conv] clockwork::logging::writers::logger_config;
use clockwork::logging::writers::logger_status;
use[] clockwork::python::example::example_channels;
use[] clockwork::python::example::example_channel_policies;
use[cpp, py_cog] clockwork::python::example::example_cog;
use clockwork::python::python_state::{PythonState};
use[cpp, proto, proto_conv] clockwork::python::tests::support::test_config;
use clockwork::python::tests::support::test_input_message;
use clockwork::python::tests::support::test_output_message;
use clockwork::python::tests::support::test_state;
use clockwork::tools::channel_spy::channel_spy_config;
use clockwork::tools::channel_spy::channel_spy_config_init;

cpu_domain LocalHost;

box ExampleBox
{
  new init_cog: example_cog::ExampleInit;
  new input1_cog: example_cog::ExampleInput1;
  new input2_cog: example_cog::ExampleInput2;
  new output_cog: example_cog::ExampleOutput;

  new memory: HeapMemory(max_size=4'096);
  new input1_config: SerializedDataFile(
    representation=Protobuf<test_config::TestConfig>,
    path="clockwork/python/example/resources/input1_config.pbtxt",
  );
  new input2_config: SerializedDataFile(
    representation=Protobuf<test_config::TestConfig>,
    path="clockwork/python/example/resources/input2_config.pbtxt",
  );
  new python_state: State(representation=PythonState, memory_resource=memory, init=init_cog.python_state);
  new input1_state: State(representation=Tachyon<test_state::TestState>, init=init_cog.input1_state);
  new input2_state: State(representation=Tachyon<test_state::TestState>, init=init_cog.input2_state);

  connect input1_config to init_cog.input1_config;
  connect input2_config to init_cog.input2_config;

  connect python_state to input1_cog.python_state;
  connect input1_state to input1_cog.state;
  connect input1_cog.output to example_channels::Input1Channel;

  connect python_state to input2_cog.python_state;
  connect input2_state to input2_cog.state;
  connect input2_cog.output to example_channels::Input2Channel;

  connect python_state to output_cog.python_state;
  connect example_channels::Input1Channel to output_cog.input1;
  connect example_channels::Input2Channel to output_cog.input2;
  connect output_cog.output to example_channels::OutputChannel;
}

box ExampleSpyBox
{
  new spy_config_memory: HeapMemory(max_size=10'000'000);
  new spy_config: SerializedDataFile(
    representation=Tachyon<channel_spy_config::ChannelSpyConfig<>>,
    path="clockwork/python/example/example_sys.example_sys.LocalHost_channel_spy_config.tachyon",
  );
  new spy_config_init_cog: channel_spy_config_init::SpyConfigInitCog;

  connect spy_config_memory to spy_config_init_cog.memres;
  connect spy_config to spy_config_init_cog.spy_config;
}

box ExampleLoggerBox
{
  new telemetry_log_writer_config: SerializedDataFile(
    representation=Tachyon<log_writer_config::LogWriterConfig<>>,
    path="clockwork/python/example/example_sys.example_sys.LocalHost_telemetry_logger_config.tachyon",
  );
  new example_logger_config: SerializedDataFile(
    representation=Protobuf<logger_config::LoggerConfig>,
    path="clockwork/python/example/resources/logger_config.pbtxt",
  );
  new logger_channel_rates_config: SerializedDataFile(
    representation=Protobuf<channel_message_rates_config::ChannelMessageRatesConfig>,
    path="clockwork/python/example/resources/channel_rates_config.pbtxt",
  );
  new logger_init_cog: logger::LoggerInitCog;
  new logger_status_publisher_cog: logger::LoggerStatusPublisherCog;
  new logger_memory: HeapMemory(max_size=300'000'000);
  new logger_state: State(
    representation=logger::LoggerCogState,
    memory_resource=logger_memory,
    init=logger_init_cog.logger_state,
  );

  connect telemetry_log_writer_config to logger_init_cog.log_writer_config;
  connect example_logger_config to logger_init_cog.logger_config;
  connect logger_channel_rates_config to logger_init_cog.channel_rates_config;
  connect logger_init_cog.logger_config_out to logger_channels::LoggerConfigChannel;
  connect logger_state to logger_status_publisher_cog.logger_state;
  connect logger_status_publisher_cog.logger_status to logger_channels::LoggerStatusChannel;
  connect logger_status_publisher_cog.channel_rates to logger_channels::LoggerMessageRatesChannel;
}

box ExampleSystem
{
  new example_box: ExampleBox;
  new spy_box: ExampleSpyBox;
  new logger_box: ExampleLoggerBox;
  new proc: Process(executable=example_clk_exe);
  apply HostProcess(process=proc) in example_box;
  apply HostProcess(process=proc) in spy_box;
  apply HostProcess(process=proc) in logger_box;
  apply HostCpuDomain(cpu_domain=LocalHost) to proc;
}
