  inputs
  {
    latest_hello: Tappy<hellomsg::HelloMsg>;

    // Multi-publisher input
    multi_publisher_hello: Tappy<hellomsg::HelloMsg>
    {
      no_dial: true;
    }

    // Multi-connect input
    multi_connect_hello: Tappy<hellomsg::HelloMsg>
    {
      multi_connect: 2;
      connect_optional: true;
    }

    // Make sure larger views work
    history_of_hellos: Tappy<hellomsg::HelloMsg>
    {
      no_dial: false;
      max_msgs: 5;
      manual_cursor: true;
    }
  }

  outputs
  {
    out_world: Tappy<hellomsg::HelloMsg>;
    out_goodbye: Tappy<hellomsg::HelloMsg>;
    out_multi1: Tappy<hellomsg::HelloMsg>;
    out_multi2: Tappy<hellomsg::HelloMsg>;
  }

  execution
  {
    condition any_msg: any_message(latest_hello);
    condition new_msg: new_message(max=2, input=history_of_hellos);
    condition new_multi_connect_hello: new_message(multi_connect_hello);
    // Execute at least at 2Hz
    condition periodic: time_since_last_exec(500ms);

    execute when: (periodic and (new_msg or new_multi_connect_hello)) or any_msg;
  }

  diagnostics
  {
    group_id: "fault_injector_b";
    instance_id: "a";
  }
  simulation_options
  {
    execution_duration: 2ms;
  }

  metrics_options
  {
    enabled: true;
  }
}

// Init cog
cog HelloInit
{
  states
  {
    result: Tappy<hellomsg::HelloMsg>
    {
      mutable: true;
    }
  }
  execution
  {
    execute when: init;
  }
}

// Init cog
cog HelloInit2
{
  states
  {
    result: Tappy<hellomsg::HelloMsg>
    {
      mutable: true;
    }

    input: Tappy<hellomsg::HelloMsg>;
  }
  execution
  {
    execute when: init;
  }
}

// These test-support cogs use the legacy bespoke metrics system for their
// unit tests and explicitly opt out of the signals-based infrastructure
// report groups to keep generated C++ output stable.
policy CogEventMetricsPolicy for HelloCog
{
  enabled = false;
}
policy CogTelemetryMetricsPolicy for HelloCog
{
  enabled = false;
}
policy CogEventMetricsPolicy for HelloCogWithMetrics
{
  enabled = false;
}
policy CogTelemetryMetricsPolicy for HelloCogWithMetrics
{
  enabled = false;
}
policy CogEventMetricsPolicy for HelloCogMinMessages
{
  enabled = false;
}
policy CogTelemetryMetricsPolicy for HelloCogMinMessages
{
  enabled = false;
}
policy CogEventMetricsPolicy for HelloCogMinNewMessages
{
  enabled = false;
}
policy CogTelemetryMetricsPolicy for HelloCogMinNewMessages
{
  enabled = false;
}
cpp_target hellocog
{
  options
  {
    namespace clockwork::testing::cogs;
    generate_cog_metrics false;
  }
  extern
  {
    header_file: "clockwork/dsl/tests/support/cxx_state.hh";
    namespace: clockwork::testing;
    type
    {
      name: CxxState;
    }
  }
  cog HelloCog;
  cog HelloCogWithMetrics;
  cog HelloInit;
  cog HelloInit2;
  cog HelloCogMinMessages;
  cog HelloCogMinNewMessages;
}
