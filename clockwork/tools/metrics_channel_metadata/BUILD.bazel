load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["metrics_channel_metadata_config.clk"])

cc_library(
    name = "metrics_channel_metadata_config",
    srcs = [
        "metrics_channel_metadata_config.cc",
        "metrics_channel_metadata_config.inl",
    ],
    hdrs = ["metrics_channel_metadata_config.hh"],
    data = [":metrics_channel_metadata_config_clk"],
    deps = [
        "//clockwork:repr_iface",
        "//clockwork:tags",
        "//clockwork/common:process_description",
        "//jewels/container/tap:var_array",
        "//jewels/container/tap:var_string",
        "//jewels/meta:concepts",
        "//jewels/uuid",
    ],
)

clk(
    name = "metrics_channel_metadata_config_clk",
    srcs = ["metrics_channel_metadata_config.clk"],
    outs = [
        "metrics_channel_metadata_config.cc",
        "metrics_channel_metadata_config.hh",
        "metrics_channel_metadata_config.inl",
    ],
    deps = ["//clockwork/common:process_description_clk"],
)

clk(
    name = "metrics_channel_metadata_init_clk",
    srcs = ["metrics_channel_metadata_init.clk"],
    outs = [
        "metrics_channel_metadata_init_cog.cc",
        "metrics_channel_metadata_init_cog.hh",
        "metrics_channel_metadata_init_cog.inl",
        "metrics_channel_metadata_init_cog_dial.cc",
        "metrics_channel_metadata_init_cog_dial.hh",
        "metrics_channel_metadata_init_cog_dial.inl",
    ],
    deps = [
        ":metrics_channel_metadata_config_clk",
        "//clockwork/dsl/cog:common_cog_event_metrics_clk",
        "//clockwork/dsl/cog:common_cog_telemetry_metrics_clk",
    ],
)

cc_library(
    name = "metrics_channel_metadata_init_cog",
    srcs = [
        "metrics_channel_metadata_init_cog.cc",
        "metrics_channel_metadata_init_cog.inl",
    ],
    hdrs = ["metrics_channel_metadata_init_cog.hh"],
    data = [":metrics_channel_metadata_init_clk"],
    deps = [
        ":metrics_channel_metadata_config",
        ":metrics_channel_metadata_init_cog_dial",
        ":metrics_channel_metadata_init_cog_impl",
        "//clockwork:repr_iface",
        "//clockwork:tags",
        "//clockwork/cog:include_common",
        "//clockwork/dsl/cog:cog_event_metrics_cpp",
        "//clockwork/dsl/cog:cog_telemetry_metrics_cpp",
        "//clockwork/dsl/cog:min_max_mean_cpp",
        "//jewels/container/tap:var_array",
        "//jewels/meta:concepts",
        "//jewels/utility:enum_flags",
        "@wise_enum",
    ],
)

cc_library(
    name = "metrics_channel_metadata_init_cog_dial",
    srcs = [
        "metrics_channel_metadata_init_cog_dial.cc",
        "metrics_channel_metadata_init_cog_dial.inl",
    ],
    hdrs = ["metrics_channel_metadata_init_cog_dial.hh"],
    data = [":metrics_channel_metadata_init_clk"],
    deps = [
        ":metrics_channel_metadata_config",
        "//clockwork/dial:include_common",
    ],
)

cc_library(
    name = "metrics_channel_metadata_init_cog_impl",
    srcs = ["metrics_channel_metadata_init_cog_impl.cc"],
    deps = [
        ":metrics_channel_metadata_config",
        ":metrics_channel_metadata_init_cog_dial",
        "//clockwork/pinion:publisher_handle",
        "//jewels/container/tap:var_array",
    ],
)
