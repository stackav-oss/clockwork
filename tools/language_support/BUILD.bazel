load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@clockwork//tools/language_support:requirements.bzl", "write_python_requirements_source_file")
load("@rules_multirun//:defs.bzl", "multirun")
load("//tools/rules:python.bzl", "py_binary")

exports_files([
    "constraints_3_10.txt",
    "constraints_3_12.txt",
    "constraints_pip310.txt",
    "requirements_3_10.txt",
    "requirements_3_12.txt",
    "uv_wrapper.py",
])

bzl_library(
    name = "requirements_bzl",
    srcs = ["requirements.bzl"],
    visibility = ["//visibility:public"],
    deps = ["@bazel_lib//lib:write_source_files"],
)

alias(
    name = "update_gazelle",
    actual = "//:gazelle_python_manifest.update",
)

multirun(
    name = "update_repo",
    commands = [
        ":update_repo_requirements_3_10",
        ":update_repo_requirements_3_12",
        ":update_repo_constraints_3_10",
        ":update_repo_constraints_3_12",
    ],
)

# This is basically a copy of repo_requirements that we can use with pip and uv's `--constraint` option
write_python_requirements_source_file(
    name = "update_repo_constraints_3_10",
    # Don't include index URL options so the resulting file can be used independently
    emit_index_urls = False,
    # Use existing locked packages in requirements_3_10.txt as a starting point because it has extras
    existing_requirements_out = "requirements_3_10.txt",
    # Don't include hashes, because they break pip's `--constraint` option
    generate_hashes = False,
    overrides_in = "requirements_overrides.txt",
    python_version = "3.10",
    requirements_in = "requirements.in",
    requirements_out = "constraints_3_10.txt",
    # Strip extras so the resulting file can be used as a constraints file
    strip_extras = True,
)

# This is basically a copy of repo_requirements_3_12 that we can use with pip and uv's `--constraint` option
# TODO(DX-29): Drop this once `@clockwork_pip` is no longer dual-parsed.
write_python_requirements_source_file(
    name = "update_repo_constraints_3_12",
    emit_index_urls = False,
    existing_requirements_out = "requirements_3_12.txt",
    generate_hashes = False,
    overrides_in = "requirements_overrides.txt",
    python_version = "3.12",
    requirements_in = "requirements.in",
    requirements_out = "constraints_3_12.txt",
    strip_extras = True,
)

# This pip hub should stay pinned on Python 3.10, to support dependencies that have no 3.12 support yet.
write_python_requirements_source_file(
    name = "update_repo_constraints_pip310",
    # Don't include index URL options so the resulting file can be used independently
    emit_index_urls = False,
    # Use existing locked packages in requirements_pip310.txt as a starting point because it has extras
    existing_requirements_out = "requirements_pip310.txt",
    # Don't include hashes, because they break pip's `--constraint` option
    generate_hashes = False,
    overrides_in = "requirements_overrides_310.txt",
    python_version = "3.10",
    requirements_in = "requirements_pip310.in",
    requirements_out = "constraints_pip310.txt",
    # Strip extras so the resulting file can be used as a constraints file
    strip_extras = True,
)

multirun(
    name = "update_repo_pip310",
    commands = [
        ":update_repo_requirements_pip310",
        ":update_repo_constraints_pip310",
    ],
)

write_python_requirements_source_file(
    name = "update_repo_requirements_3_10",
    overrides_in = "requirements_overrides.txt",
    python_version = "3.10",
    requirements_in = "requirements.in",
    requirements_out = "requirements_3_10.txt",
)

# Lock for the 3.12 side of the dual-version `@clockwork_pip` hub.
# TODO(DX-29): retire once `@clockwork_pip` is no longer dual-parsed.
write_python_requirements_source_file(
    name = "update_repo_requirements_3_12",
    overrides_in = "requirements_overrides.txt",
    python_version = "3.12",
    requirements_in = "requirements.in",
    requirements_out = "requirements_3_12.txt",
)

# This pip hub should stay pinned on Python 3.10, to support dependencies that have no 3.12 support yet.
# TODO(DX-29): remove this once all dependencies support Python 3.12
write_python_requirements_source_file(
    name = "update_repo_requirements_pip310",
    overrides_in = "requirements_overrides_310.txt",
    python_version = "3.10",
    requirements_in = "requirements_pip310.in",
    requirements_out = "requirements_pip310.txt",
)

multirun(
    name = "update_requirements",
    commands = [
        ":update_repo",
        ":update_repo_pip310",
    ],
    jobs = 0,
)

alias(
    name = "uv_bin",
    actual = "@clockwork_pip//uv:bin_uv",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "uv_toml",
    srcs = ["uv.toml"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "uv_wrapper",
    srcs = ["uv_wrapper.py"],
    data = ["@clockwork_pip//uv:bin_uv"],
    visibility = ["//visibility:public"],
    deps = ["@clockwork_pip//click"],
)
