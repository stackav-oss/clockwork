    ("stardoc", SINGLE_VERSION_OVERRIDE, "0.8.0", NO_PATCH),
    ("tclap", "https://github.com/mirror/tclap.git", "61cfae16ceba4cadc3d74439fa1e9fd4fce16bc9", PATCH),  # 1.4
