clk_proto_prefix_enum_value_names := "prefix_enum_value_names" . " "* . "=" . " "* . prefix:boolean ;

clk_proto_conv_attr := "proto_conv" . "(" , clk_proto_conv_values , ")" ;
clk_proto_conv_values := clk_proto_conv_value , ("," , clk_proto_conv_value)* , ;
clk_proto_conv_value := clk_protobuf_to_tap | clk_tap_to_protobuf | clk_proto_conv_namespace ;
clk_protobuf_to_tap := "protobuf_to_tap" . " "* . "=" . " "* . value:boolean ;
clk_tap_to_protobuf := "tap_to_protobuf" . " "* . "=" . " "* . value:boolean ;
clk_proto_conv_namespace := "namespace" . " "* . "=" . " "* . namespace:namespace_path ;

clk_exe_attr := "exe" . "(" , clk_offline? , ")" ;
clk_offline := "offline" . " "* . "=" . " "* . value:boolean ;

clk_py_cog_attr := "py_cog" . "(" , clk_wrapper_type? , ")" ;
clk_wrapper_type := "wrapper_type" . " "* . "=" . " "* . (nanobind:"nanobind" | python:"python") ;

clk_instantiate_stmt := doc? . clk_outer_attrs? . "instantiate" : (name:identifier , ":" ,)? .  typespec:expr , ";" , ;
python_cog := doc? . clk_outer_attrs? . "python_cog" : identifier , cog_blocks , ;

clk_entity := cog | python_cog | schema | enum | tag | channel | module_scope_signal | udp_socket | multicast_udp_socket | box | strong_type | policy_def | policy | extern_type | cpu_domain | ethernet | assignment_stmt | pcie_link | clk_instantiate_stmt | audio_source | dfl_trait_def | dfl_impl_decl | dfl_fn_def | aligner ;

// ---------------------------------------------------------------------------
// DFL (Declarative Functional Language) Expressions
// ---------------------------------------------------------------------------

// Trait definitions: trait Add<Rhs = Self> { type Output; }
dfl_trait_def := doc? . "trait" : identifier , dfl_trait_type_params? , (dfl_trait_body | ";") , ;
dfl_trait_type_params := "<" , dfl_trait_type_param , ("," , dfl_trait_type_param)* , ">" ;
dfl_trait_type_param := name:identifier , ("=" , default:dfl_type_param_default)? ;
dfl_type_param_default := self_type:"Self" | typespec:expr ;
dfl_trait_body := "{" , dfl_trait_assoc_type_decl* , "}" ;
dfl_trait_assoc_type_decl := dfl_trait_assoc_type , ";" , ;
dfl_trait_assoc_type := "type" : name:identifier ;

// Impl declarations: impl Add<Float64> for Duration { type Output = Duration; }
dfl_impl_decl := doc? . "impl" : trait:expr , "for" : for_type:expr , (dfl_impl_body | ";") , ;
dfl_impl_body := "{" , dfl_impl_assoc_type_decl* , "}" ;
dfl_impl_assoc_type_decl := dfl_impl_assoc_type , ";" , ;
dfl_impl_assoc_type := "type" : name:identifier , "=" , typespec:expr ;

// Function definitions: fn double(x) { x + x }
dfl_fn_def := doc? . "fn" : name:identifier , "(" , dfl_fn_params? . ","? , ")" , dfl_fn_return_type? , "{" , body:dfl_expr , "}" , ;
dfl_fn_params := dfl_variadic_param | dfl_fn_param , ("," , (dfl_variadic_param | dfl_fn_param) ,)* ;
dfl_fn_param := name:identifier , (":" , typespec:expr)? ;
dfl_variadic_param := name:identifier . "..." , (":" , typespec:expr)? ;
dfl_fn_return_type := "->" , typespec:expr ;


// DFL expression entry point
dfl_expr := dfl_or_expr | statement;

// Boolean operators (lowest precedence)
dfl_or_expr := dfl_and_expr , ("or" : dfl_and_expr)* ;
dfl_and_expr := dfl_not_expr , ("and" : dfl_not_expr)* ;
dfl_not_expr := "not" : dfl_not_expr | dfl_comparison_expr ;

// Comparison operators
dfl_comparison_expr := dfl_additive_expr , (dfl_comparison_op , dfl_additive_expr)? ;
dfl_comparison_op := eq:"==" | ne:"!=" | le:"<=" | ge:">=" | lt:"<" | gt:">" ;

// Arithmetic operators
dfl_additive_expr := dfl_multiplicative_expr , (dfl_additive_op , dfl_multiplicative_expr)* ;
dfl_additive_op := add:"+" | sub:"-" ;

dfl_multiplicative_expr := dfl_unary_expr , (dfl_multiplicative_op , dfl_unary_expr)* ;
dfl_multiplicative_op := mul:"*" | div:"/" | mod:"%" ;

// Unary operators
dfl_unary_expr := (neg:"-" | pos:"+") . dfl_unary_expr | dfl_postfix_expr ;

// Postfix expressions
dfl_postfix_expr := dfl_primary_expr , (dfl_call_suffix | dfl_instantiate_suffix | dfl_member_suffix)* ;
dfl_instantiate_suffix := "<" , dfl_arg_list , ">" ;
dfl_call_suffix := "(" , dfl_arg_list? , ")" ;
dfl_member_suffix := "." . identifier ;
dfl_arg_list := dfl_arg , ("," , dfl_arg)* , ","? ;
dfl_arg := (name:identifier , "=")? , value:dfl_expr . spread:"..."? ;

// Primary expressions
dfl_primary_expr := dfl_lambda | dfl_abs_expr | dfl_if_expr | dfl_cond_expr | dfl_match_expr | dfl_array_literal | dfl_paren_expr | literal | namespaced_identifier | identifier ;
dfl_lambda := "fn" , "(" , dfl_lambda_params? , ")" , dfl_expr ;
dfl_lambda_params := identifier , ("," , identifier)* ;
dfl_abs_expr := "|" , dfl_expr , "|" ;
dfl_paren_expr := "(" , dfl_expr , ")" ;
dfl_array_literal := "[" , (dfl_expr , ("," , dfl_expr)* , ","?)? , "]" ;

// Conditional expressions
dfl_if_expr := "if" : condition:dfl_expr , "then" : if_true:dfl_expr , "else" : if_false:dfl_expr ;

dfl_cond_expr := "cond" , "{" , dfl_cond_arms , "}" ;
dfl_cond_arms := dfl_cond_arm , ("," , dfl_cond_arm ,)* . ","? ;
dfl_cond_arm := dfl_cond_guard , "=>" , dfl_expr ;
dfl_cond_guard := else_guard:"else" | dfl_expr ;

// Match expressions
dfl_match_expr := "match" : scrutinee:dfl_expr , "{" , dfl_match_arms , "}" ;
dfl_match_arms := dfl_match_arm , ("," , dfl_match_arm ,)* . ","? ;
dfl_match_arm := dfl_match_pattern , "=>" , dfl_expr ;

// Pattern matching
dfl_range_pattern := lo:integer , ".." , hi:integer ;
dfl_simple_pattern := literal | namespaced_identifier ;
dfl_pattern := dfl_range_pattern | dfl_simple_pattern ;
dfl_pattern_list := dfl_pattern , ("|" , dfl_pattern ,)* ;
dfl_match_pattern := else:"else" | dfl_pattern_list ;

// ---------------------------------------------------------------------------
// Aligner Definitions
// ---------------------------------------------------------------------------

aligner := doc . clk_outer_attrs? . "aligner" : identifier , "{" , aligner_inputs_block , aligner_body , "}" , ;

// Inputs block with input declarations
aligner_inputs_block := "inputs" , "{" , aligner_input_def+ , "}" , ;
aligner_input_def := doc? . identifier , ":" , input_type:expr , (block | ";") , ;

// Body: sequence of DFL statements (let bindings, function definitions, specifications)
aligner_body := aligner_body_stmt* ;
aligner_body_stmt := aligner_let_stmt | dfl_fn_def | aligner_spec_stmt ;
aligner_let_stmt := "let" : identifier , "=" , dfl_expr , ";" , ;
aligner_spec_stmt := dfl_expr , ";" , ;
