type_id := identifier | namespaced_identifier;
type_union := type_id , ("|" , type_id)+;

identifier := value:/[_a-zA-Z][_a-zA-Z0-9]*/;
namespaced_identifier := namespace:identifier . "::" . extern_entity:identifier ;
namespace_path := identifier . ("::" . identifier)*;
dotted_identifier := (parent:dotted_identifier | root:identifier) , "." , child:identifier;
package_name := identifier . ("." . identifier)*;
go_package_name := identifier . go_package_name_segment*;
go_package_name_segment := go_package_dot_segment | go_package_slash_segment | go_package_dash_segment;
go_package_dot_segment := dot:"." . identifier;
go_package_slash_segment := slash:"/" . identifier;
go_package_dash_segment := dash:"-" . identifier;

literal := unit_literal | number | string_literal;
nonnegative_integer := value:/[0-9]('?[0-9])*/;
integer := sign? . nonnegative_integer;
number := sign? . whole_part:nonnegative_integer . ("." . fractional_part:nonnegative_integer)? . (("e" | "E") . exponent:integer)?;
