use clockwork::dsl::tests::support::hellomsg;
use clockwork::diagnostics::report::{Report as DiagnosticsReport};
use std::cog_metrics_policy::{CogEventMetricsPolicy, CogTelemetryMetricsPolicy};

//
extern_type CxxState
{
  serialized_form
  {
    representation: Tachyon<hellomsg::HelloMsg>;
  }
}

// Hello, Cog!
//
// This cog is a minimal test case for the Clockwork framework.
cog HelloCog
{
  resources
  {
    mem_hello: persistent;
  }

  configs
  {
    cfg_hello: Tappy<hellomsg::HelloMsg>;
  }

  states
  {
    ro_hello: Tappy<hellomsg::HelloMsg>;
    rw_hello: Tappy<hellomsg::HelloMsg>
    {
      mutable: true;
    }
    extern_hello: CxxState;
  }

  inputs
  {
    latest_hello: Tappy<hellomsg::HelloMsg>
    {
      connect_optional: true;
    }

    // Multi-publisher input
    multi_publisher_hello: Tappy<hellomsg::HelloMsg>
    {
      no_dial: true;
    }

    // Multi-connect input
    multi_connect_hello: Tappy<hellomsg::HelloMsg>
    {
      multi_connect: 2;
      connect_optional: true;
    }

    // Make sure larger views work
    history_of_hellos: Tappy<hellomsg::HelloMsg>
    {
      no_dial: false;
      max_msgs: 5;
      manual_cursor: true;
      connect_optional: true;
    }
  }

  outputs
  {
    out_world: Tappy<hellomsg::HelloMsg>
    {
      connect_optional: true;
    }
    out_goodbye: Tappy<hellomsg::HelloMsg>
    {
      connect_optional: true;
    }
    out_multi1: Tappy<hellomsg::HelloMsg>
    {
      connect_optional: true;
    }
    out_multi2: Tappy<hellomsg::HelloMsg>
    {
      connect_optional: true;
    }
  }

  execution
  {
    condition any_msg: any_message(latest_hello);
    condition new_msg: new_message(max=2, input=history_of_hellos);
    condition new_multi_connect_hello: new_message(multi_connect_hello);
    // Execute at least at 2Hz
    condition periodic: time_since_last_exec(500ms);

    execute when: (periodic and (new_msg or new_multi_connect_hello)) or any_msg;
  }

  diagnostics
  {
    group_id: "fault_injector_b";
    instance_id: "a";
  }
  simulation_options
  {
    execution_duration: 2ms;
  }

  metrics_options
  {
    enabled: true;
  }
}

// This cog has an execution condition that guarantees there's a message.
cog HelloCogMinMessages
{
  inputs
  {
    hello: Tappy<hellomsg::HelloMsg>;
  }

  execution
  {
    condition any_hello: any_message(hello);
    execute when: any_hello;
  }
}

// This cog has an execution condition that guarantees there's a new message.
cog HelloCogMinNewMessages
{
  inputs
  {
    hello: Tappy<hellomsg::HelloMsg>;
  }

  execution
  {
    condition new_hello: new_message(hello);
    execute when: new_hello;
  }
}

