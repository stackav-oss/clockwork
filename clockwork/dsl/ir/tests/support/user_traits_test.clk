// Test file demonstrating user-defined strong types with trait implementations.

#![generate()]

use std::traits::{Add, Sub, Neg, Ord, Eq};

// A user-defined strong type for temperature
strong_type Celsius
{
  underlying_type: Float64;
}

// Implement arithmetic traits for Celsius
impl Add for Celsius
{
  type Output = Celsius;
}
impl Sub for Celsius
{
  type Output = Celsius;
}
impl Neg for Celsius
{
  type Output = Celsius;
}
impl Ord for Celsius;
impl Eq for Celsius;
