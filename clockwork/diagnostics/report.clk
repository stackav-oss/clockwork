#![generate(cpp)]
#![cpp(namespace=clockwork::diagnostics)]

// Type tag for diagnostic reporter Uuid
tag ReporterId;

// Result of executing the cog that produced a diagnostic report
enum ReportHealth
{
  uuid: 56ed5cee-30ae-4860-88aa-26b05abad405;

  values
  {
    // The executed without issue
    #0 healthy default;
  }
}

// Report
schema Report
{
  uuid: 648ab6b9-eca6-49e4-9200-3baa620ba805;
  options
  {
    constructor: source_code_order;
  }
  fields
  {
    // Timestamp of the cycle this report is associated with
    #3 timestamp: SyncTime;

    // Uuid for this reporter
    #4 id: Uuid<ReporterId>;

    // Result of the cog execution associated with this report
    #5 health: ReportHealth = ReportHealth::healthy;
  }
}
