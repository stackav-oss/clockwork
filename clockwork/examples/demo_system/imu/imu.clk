#![generate(cpp, cpp_cog, cpp_exe)]
#![cpp(namespace=clockwork::demo_system::imu)]

use[] clockwork::examples::demo_system::cpu_domain;
use[] clockwork::examples::demo_system::imu::imu_channels;
use clockwork::examples::demo_system::imu::imu_message;

// Cog to simulate the IMU device sending raw IMU packets over UDP
cog ImuDeviceCog
{
  parameters
  {
    msg_type: Type;
  }
  outputs
  {
    raw_imu: Tappy<msg_type>;
  }

  execution
  {
    condition periodic_10ms: time_since_last_exec(10ms);
    execute when: periodic_10ms;
  }
}

instantiate ImuDeviceCog<msg_type=imu_message::ImuMessage>;

// Cog to simulate a driver that converts raw IMU packets into IMU messages
cog ImuDriverCog
{
  parameters
  {
    msg_type: Type;
  }
  inputs
  {
    raw_imu: Tappy<msg_type>;
  }

  outputs
  {
    imu: Tappy<imu_message::ImuMessage>;
  }

  execution
  {
    condition new_raw_imu: new_message(raw_imu, max=1);
    execute when: new_raw_imu;
  }
}

instantiate ImuDriverCog<msg_type=imu_message::ImuMessage>;

box ImuBox
{
  new device_cog: ImuDeviceCog<msg_type=imu_message::ImuMessage>;
  new driver_cog: ImuDriverCog<msg_type=imu_message::ImuMessage>;

  connect device_cog.raw_imu to imu_channels::RawImuChannel;
  connect imu_channels::RawImuChannel to driver_cog.raw_imu;
  connect driver_cog.imu to imu_channels::ImuChannel<name="/imu", type=imu_message::ImuMessage>;
}

box ImuExe
{
  new imu_box: ImuBox;
  new imu_proc: Process(executable=imu_clk_exe);
  apply HostProcess(process=imu_proc) in imu_box;
  apply HostCpuDomain(cpu_domain=cpu_domain::LocalHost) to imu_proc;
}
