#![cpp(namespace=clockwork_logging)]

// Logger configuration
schema LoggerConfig
{
  uuid: c6456c0b-cb9e-450b-9a74-e70bc01177d5;
  fields
  {

    // Log root directory
    #1 log_root_dir: VarString<256>;

    // Shared memory root directory
    #2 pinion_shm_root: VarString<256>;

    // Pinion unix socket namespace
