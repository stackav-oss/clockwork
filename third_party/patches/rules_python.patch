-def _create_run_environment_info(ctx, inherited_environment):
+def _create_run_environment_info(ctx, inherited_environment, runfiles_details):
     expanded_env = {}
     for key, value in ctx.attr.env.items():
         expanded_env[key] = _py_builtins.expand_location_and_make_variables(
@@ -944,6 +944,32 @@ def _create_run_environment_info(ctx, inherited_environment):
             expression = value,
             targets = ctx.attr.data,
         )
+
+    # Infers the `LD_LIBRARY_PATH` environment variable if enabled based on the presence of
+    # shared library files (.so) in the runfiles of the target. The existing `LD_LIBRARY_PATH`
+    # value is preserved if present.
+    if ctx.attr.infer_ld_library_path:
+        ld_library_path = {}
+        for file in runfiles_details.runfiles_without_exe.files.to_list():
+            if ".so" in file.basename:
+                include = (
+                    not ctx.attr.shared_object_include_substrings or
+                    any([s in file.short_path for s in ctx.attr.shared_object_include_substrings])
+                )
+                exclude = (
+                    ctx.attr.shared_object_exclude_substrings and
+                    any([s in file.short_path for s in ctx.attr.shared_object_exclude_substrings])
+                )
+                if include and not exclude:
+                    lib_path = file.short_path.removesuffix(file.basename).rstrip("/")
+                    ld_library_path[lib_path] = True
+
+        if ld_library_path:
+            paths = []
+            paths += expanded_env["LD_LIBRARY_PATH"].split(":") if "LD_LIBRARY_PATH" in expanded_env else []
+            paths += ld_library_path.keys()
+            expanded_env["LD_LIBRARY_PATH"] = ":".join(paths)
+
     return RunEnvironmentInfo(
         environment = expanded_env,
         inherited_environment = inherited_environment,
