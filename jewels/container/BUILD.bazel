load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")

cc_library(
    name = "at",
    hdrs = ["at.hh"],
    visibility = ["//visibility:public"],
    deps = ["@gsl//:util"],
)

cc_library(
    name = "bounded_string",
    srcs = ["bounded_string.inl"],
    hdrs = ["bounded_string.hh"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "circular_buffer",
    srcs = ["circular_buffer.inl"],
    hdrs = ["circular_buffer.hh"],
    visibility = ["//visibility:public"],
    deps = [
        ":circular_buffer_state_clk_cc",
        "//jewels/memory:aligned_storage",
        "//jewels/memory:memory_resource",
        "//jewels/meta:call",
        "//jewels/meta:type_traits",
        "//jewels/std:expected",
        "@boost//:iterator",
        "@wise_enum",
    ],
)

clk(
    name = "circular_buffer_state_clk",
    srcs = ["circular_buffer_state.clk"],
    outs = [
        "circular_buffer_state_clk_cc.cc",
        "circular_buffer_state_clk_cc.hh",
        "circular_buffer_state_clk_cc.inl",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "circular_buffer_state_clk_cc",
    srcs = [
        "circular_buffer_state_clk_cc.cc",
        "circular_buffer_state_clk_cc.inl",
    ],
    hdrs = ["circular_buffer_state_clk_cc.hh"],
    data = [":circular_buffer_state_clk"],
    visibility = ["//visibility:public"],
    deps = [
        "//clockwork:repr_iface",
        "//clockwork:tags",
        "//jewels/meta:concepts",
        "//jewels/uuid",
    ],
)

cc_library(
    name = "compare",
    srcs = ["compare.inl"],
    hdrs = ["compare.hh"],
    visibility = ["//visibility:public"],
)
