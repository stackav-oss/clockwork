use clockwork::dsl::tests::support::clk_parameterized_box::{TestBox};

cpu_domain ClkTestHost
{
  simplelaunch_node: "ClkParameterizedHost";
  simplelaunch_src: "//clockwork/dsl/tests/support:clk_host_a_simplelaunch_config.textproto";
  bridge_cpus: 0;
  default_cpus: 1 - 3;
}

ethernet TestLan
{
  ipv4_address 1.2.3.4: ClkTestHost
  {
    bridge_ports: 16000 - 18000;
  }
}

box TestSystemBox
{
  new box: TestBox;
  apply HostCpuDomain(cpu_domain=ClkTestHost) in box;
}

system_target clk_parameterized_system
{
  box: TestSystemBox;
}
