use clockwork::tests::support::exec_time::{ExecState};
use clockwork::tests::support::snapshot_test_messages::{
  SerializableStateSnapshot,
  StateUpdateMessage,
  SnapshotTestConfig,
};

// External state used by the online snapshot and offline restore fixture
extern_type SerializableState
{
  serialized_form
  {
    representation: Tachyon<SerializableStateSnapshot>;
  }
}

// Updates the state before taking an online snapshot
cog SerializableStateWriterCog
{
  states
  {
    state: SerializableState
    {
      mutable: true;
    }
  }

  inputs
  {
    update: Tappy<SerializableStateSnapshot>;
  }

  execution
  {
    condition new_update: new_message(update);
    execute when: new_update;
  }
}

// Reads restored state during its first execution
cog SerializableStateReaderCog
{
  states
  {
    state: SerializableState;
  }

  outputs
  {
    observed: Tappy<SerializableStateSnapshot>;
  }

  execution
  {
    execute when: init;
  }
}

// Stateful cog that maintains a counter and responds to update messages
cog StatefulCog
{
  configs
  {
    config: Tappy<SnapshotTestConfig>;
  }

  states
  {
    state: Tappy<ExecState>
    {
      mutable: true;
    }
  }

  inputs
  {
    update_message: Tappy<StateUpdateMessage>
    {
      max_msgs: 5;
    }
  }

  execution
  {
    condition new_update: new_message(update_message);
    condition periodic: time_since_last_exec(50ms);
    execute when: new_update or periodic;
  }
}

cpp_target snapshot_test_cogs
{
  options
  {
    namespace clockwork::testing;
  }

  extern
  {
    header_file: "clockwork/tests/support/serializable_state.hh";
    namespace: clockwork::testing;
    type
    {
      name: SerializableState;
    }
  }

  cog SerializableStateWriterCog;
  cog SerializableStateReaderCog;
  cog StatefulCog;
}
