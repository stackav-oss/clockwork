load("//clockwork:rules.bzl", "clk")
load("//tools/rules:cc.bzl", "cc_library")

clk(
    name = "signal_metadata_init_clk",
    srcs = ["signal_metadata_init.clk"],
    outs = [
        "signal_metadata_init_clk_cc.cc",
        "signal_metadata_init_clk_cc.hh",
        "signal_metadata_init_clk_cc.inl",
        "signal_metadata_init_clk_cc_cog.cc",
        "signal_metadata_init_clk_cc_cog.hh",
        "signal_metadata_init_clk_cc_cog.inl",
        "signal_metadata_init_clk_cc_dial.cc",
        "signal_metadata_init_clk_cc_dial.hh",
        "signal_metadata_init_clk_cc_dial.inl",
        "signal_metadata_init_clk_cc_types.cc",
        "signal_metadata_init_clk_cc_types.hh",
        "signal_metadata_init_clk_cc_types.inl",
    ],
    cpp_deps = ["//clockwork/common:signal_metadata_config_clk_cc"],
    generate = [
        "cpp",
        "cpp_cog",
    ],
    visibility = ["//visibility:public"],
    deps = ["//clockwork/common:signal_metadata_config_clk"],
)

cc_library(
    name = "signal_metadata_init_clk_cc_impl",
    srcs = ["signal_metadata_init_clk_cc_impl.cc"],
    deps = [
        ":signal_metadata_init_clk_cc_dial",
        "//clockwork/common:signal_metadata_config_clk_cc",
        "//clockwork/memory:start_lifetime_as",
        "//clockwork/pinion:publishable",
        "//clockwork/pinion:slot",
        "//jewels/uuid",
    ],
)
