use clockwork::logging::writers::channel_message_rates::ChannelMessageRates;
use clockwork::logging::log_writer_config::LogWriterConfig;
use clockwork::logging::writers::logger_status::LoggerStatus;
use clockwork::logging::writers::logger_config::LoggerConfig;
use clockwork::logging::writers::channel_message_rates_config::ChannelMessageRatesConfig;

// Logger cog state
extern_type LoggerCogState;

// Logger init cog
cog LoggerInitCog
{
  configs
  {
    logger_config : Tappy<LoggerConfig>;
    log_writer_config: Tappy<LogWriterConfig<>>;
    channel_rates_config: Tappy<ChannelMessageRatesConfig>;
  }

  states
  {
    logger_state: LoggerCogState
    {
      mutable: true;
    }
  }

  outputs
  {
    logger_config_out: Tappy<LoggerConfig>;
  }

  execution
  {
      execute when: init;
  }
}

// Logger status publisher cog
cog LoggerStatusPublisherCog
{
  states
  {
    logger_state: LoggerCogState
    {
      mutable: true;
    }
  }

  outputs
  {
    logger_status: Tappy<LoggerStatus>;
    channel_rates: Tappy<ChannelMessageRates<>>;
  }

  execution
  {
    condition periodic_100ms: time_since_last_exec(100ms);
    execute when: periodic_100ms;
  }
}

cpp_target logger_cog
{
  options
  {
    namespace clockwork_logging;
  }

  extern
  {
    header_file: "clockwork/logging/writers/logger_cog_state.hh";
    namespace: clockwork_logging;
    type
    {
        name: LoggerCogState;
    }
  }

  cog LoggerInitCog;
  cog LoggerStatusPublisherCog;
}
